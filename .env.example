# .env.example - Configuración para el despliegue del TFG
# Instrucciones: Renombrar este archivo a .env y ejecutar 'docker compose up -d'

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=asufisudg123
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:!ChangeMe!@database:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Mailpit para atrapar los correos del profesor en desarrollo
MAILER_DSN=smtp://localhost:1025
###< symfony/mailer ###
###< symfony/mailer ###