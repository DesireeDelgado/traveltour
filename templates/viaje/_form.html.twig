<main class="max-w-4xl mx-auto pt-24 px-6">
    <!-- Back Button & Header -->
    <div class="flex items-center gap-4 mb-10">
        <a href="{{ path('app_viaje_index') }}" class="flex items-center gap-2 group text-on-surface-variant hover:text-primary transition-colors">
            <span class="bg-slate-200 group-hover:bg-blue-100 p-2 rounded-full transition-all duration-200 flex items-center justify-center">
                {{ ux_icon('lucide:arrow-left', {'class': 'w-5 h-5'}) }}
            </span>
            <span class="font-semibold tracking-tight">Volver atrás</span>
        </a>
    </div>
    <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-on-surface mb-2 font-display">
            {% if is_edit|default(false) %}
                Editar Viaje
            {% else %}
                Crear Nuevo Viaje
            {% endif %}
        </h1>
        <p class="text-on-surface-variant text-lg">Inmortaliza tu próxima aventura en tu diario digital.</p>
    </div>
    
    {{ form_start(form, {'attr': {'class': 'grid grid-cols-1 md:grid-cols-2 gap-8', 'enctype': 'multipart/form-data'}}) }}
        <div class="col-span-1 md:col-span-2 text-rose-500 font-bold">
            {{ form_errors(form) }}
        </div>
        
        <!-- Left Column: Primary Details -->
        <div class="space-y-8">
            <div class="flex flex-col gap-2">
                <label class="text-xs font-bold uppercase tracking-widest text-slate-500 px-4">Título del viaje</label>
                {{ form_widget(form.titulo, {'attr': {'class': 'w-full bg-slate-200 border-none rounded-full px-6 py-4 text-slate-800 placeholder:text-slate-400 focus:ring-2 focus:ring-blue-600/20 transition-all', 'placeholder': 'Ej: Atardeceres en Santorini'}}) }}
                <div class="text-red-500 text-sm px-4">{{ form_errors(form.titulo) }}</div>
            </div>
            
            <div class="flex flex-col gap-2">
                <label class="text-xs font-bold uppercase tracking-widest text-slate-500 px-4">Destino</label>
                <div class="relative" {% if is_edit|default(false) %}onclick="alert('Este campo no se puede editar')" title="Este campo no se puede editar"{% endif %}>
                    <span class="absolute left-5 top-1/2 -translate-y-1/2 text-blue-600 flex items-center justify-center">
                        {{ ux_icon('lucide:map-pin', {'class': 'w-5 h-5'}) }}
                    </span>
                    {% set destino_attr = {'class': 'w-full bg-slate-200 border-none rounded-full pl-12 pr-6 py-4 text-slate-800 placeholder:text-slate-400 focus:ring-2 focus:ring-blue-600/20 transition-all', 'placeholder': '¿A dónde fuiste?'} %}
                    {% if is_edit|default(false) %}
                        {% set destino_attr = destino_attr|merge({'readonly': 'readonly', 'class': destino_attr.class ~ ' opacity-70 bg-slate-300 pointer-events-none'}) %}
                    {% endif %}
                    {{ form_widget(form.destino, {'attr': destino_attr}) }}
                </div>
                <div class="text-red-500 text-sm px-4">{{ form_errors(form.destino) }}</div>
            </div>
            
            <div class="grid grid-cols-2 gap-4">
                <div class="flex flex-col gap-2">
                    <label class="text-xs font-bold uppercase tracking-widest text-slate-500 px-4">Duración (días)</label>
                    <div class="relative">
                        {{ form_widget(form.duracion, {'attr': {'class': 'w-full bg-slate-200 border-none rounded-full px-6 py-4 text-slate-800 focus:ring-2 focus:ring-blue-600/20 transition-all', 'placeholder': 'Ej: 5'}}) }}
                    </div>
                    <div class="text-red-500 text-sm px-4">{{ form_errors(form.duracion) }}</div>
                </div>
                <div class="flex flex-col gap-2">
                    <label class="text-xs font-bold uppercase tracking-widest text-slate-500 px-4">Presupuesto</label>
                    <div class="relative">
                        <span class="absolute left-6 top-1/2 -translate-y-1/2 text-slate-500 font-medium">€</span>
                        {{ form_widget(form.presupuesto, {'attr': {'class': 'w-full bg-slate-200 border-none rounded-full pl-10 pr-6 py-4 text-slate-800 placeholder:text-slate-400 focus:ring-2 focus:ring-blue-600/20 transition-all', 'placeholder': '0.00'}}) }}
                    </div>
                    <div class="text-red-500 text-sm px-4">{{ form_errors(form.presupuesto) }}</div>
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <label class="text-xs font-bold uppercase tracking-widest text-slate-500 px-4">¿Dónde te alojaste?</label>
                {{ form_widget(form.alojamiento, {'attr': {'class': 'w-full bg-slate-200 border-none rounded-xl px-6 py-4 text-slate-800 placeholder:text-slate-400 focus:ring-2 focus:ring-blue-600/20 transition-all resize-none', 'placeholder': 'Describe tu estancia...', 'rows': '3'}}) }}
                <div class="text-red-500 text-sm px-2">{{ form_errors(form.alojamiento) }}</div>
            </div>
            <div class="flex flex-col gap-2">
                <label class="text-xs font-bold uppercase tracking-widest text-slate-500 px-4">¿Dónde comiste?</label>
                {{ form_widget(form.gastronomia, {'attr': {'class': 'w-full bg-slate-200 border-none rounded-xl px-6 py-4 text-slate-800 placeholder:text-slate-400 focus:ring-2 focus:ring-blue-600/20 transition-all resize-none', 'placeholder': 'Restaurantes, comida callejera, cafés...', 'rows': '3'}}) }}
                <div class="text-red-500 text-sm px-2">{{ form_errors(form.gastronomia) }}</div>
            </div>
        </div>
        
        <!-- Right Column: Experiences & Media -->
        <div class="space-y-8">
            <div class="flex flex-col gap-2 h-full">
                <label class="text-xs font-bold uppercase tracking-widest text-slate-500 px-4">¿Qué viste? (Experiencias)</label>
                {{ form_widget(form.contenido, {'attr': {'class': 'w-full h-full min-h-[200px] bg-slate-200 border-none rounded-xl px-6 py-4 text-slate-800 placeholder:text-slate-400 focus:ring-2 focus:ring-blue-600/20 transition-all resize-none', 'placeholder': 'Actividades, monumentos, joyas ocultas...'}}) }}
                <div class="text-red-500 text-sm px-2">{{ form_errors(form.contenido) }}</div>
            </div>
        </div>
        
        {% if not is_edit|default(false) %}
        <!-- Full Width Visual Element (Asymmetric Bento) -->
        <div class="md:col-span-2 mt-4">
            <div class="bg-slate-50 rounded-xl p-8 flex flex-col md:flex-row items-center gap-8 border border-slate-200">
                <div class="flex-1 space-y-4 w-full">
                    <h3 class="text-xl font-bold tracking-tight text-slate-800">Agrega fotos a tu historia</h3>
                    <p class="text-slate-600 leading-relaxed mb-4">
                        Sube entre 1 y 5 imágenes. <strong>Asegúrate de seleccionar todas a la vez</strong> desde la ventana de archivos.
                    </p>
                    
                    <div class="w-full mt-6">
                        {# Muestra mensajes de error de validación para las imágenes #}
                        {{ form_errors(form.imagenes) }}
                        
                        {{ form_widget(form.imagenes, {
                            'attr': {
                                'class': 'block w-full text-sm text-slate-500 file:mr-4 file:py-3 file:px-6 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 transition-colors focus:outline-none mb-4 cursor-pointer',
                                'accept': 'image/*'
                            }
                        }) }}
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        {{ form_rest(form) }}
        
        <!-- Submit Action -->
        <div class="md:col-span-2 flex justify-center pt-8 pb-12">
            <button id="submit-btn" class="group relative px-12 py-5 bg-gradient-to-br from-[#005d90] to-[#0077B6] text-white rounded-full font-bold text-lg shadow-[0_12px_32px_rgba(0,93,144,0.3)] hover:scale-[1.02] active:scale-95 transition-all duration-300" type="submit">
                <span class="flex items-center gap-3">
                    <span id="submit-text">{{ button_label|default('Guardar Itinerario') }}</span>
                    <span class="group-hover:translate-x-1 transition-transform flex items-center">
                        {{ ux_icon('lucide:send', {'class': 'w-5 h-5'}) }}
                    </span>
                </span>
            </button>
        </div>
    {{ form_end(form) }}
</main>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector('form');
    const fileInput = document.querySelector('input[type="file"]');
    const submitBtn = document.getElementById('submit-btn');

    if (form && fileInput) {
        let isSubmitting = false;

        form.addEventListener('submit', async (e) => {
            if (isSubmitting) {
                e.preventDefault();
                return;
            }

            if (fileInput.files.length === 0) return;
            
            e.preventDefault(); // Detenemos el envío para procesar las imágenes
            isSubmitting = true;
            submitBtn.disabled = true;
            
            let originalText = 'Guardar';
            const textSpan = submitBtn.querySelector('#submit-text');
            if (textSpan) {
                originalText = textSpan.innerText;
                textSpan.innerText = 'Procesando imágenes...';
            } else {
                originalText = submitBtn.innerText;
                submitBtn.innerText = 'Procesando imágenes...';
            }

            try {
                const dataTransfer = new DataTransfer();
                const files = Array.from(fileInput.files);

                for (const file of files) {
                    try {
                        const compressed = await imageCompression(file, {
                            maxSizeMB: 0.3, 
                            maxWidthOrHeight: 800,
                            useWebWorker: false, // Deshabilitar WebWorker porque puede colgarse en ciertos navegadores/incógnito
                            preserveExif: false
                        });

                        const newFile = new File([compressed], file.name, { type: file.type || 'image/jpeg' });
                        dataTransfer.items.add(newFile);
                        console.log(`Finalizada compresión de: ${file.name}`);
                    } catch (compressionError) {
                        console.error('Error comprimiendo la imagen, se enviará la original:', compressionError);
                        dataTransfer.items.add(file); // Si falla, añadimos la original para que no se pierda
                    }
                }

                // Sustituimos los archivos del input por los comprimidos
                fileInput.files = dataTransfer.files;
                
                if (textSpan) textSpan.innerText = 'Subiendo...';
                
                // Enviamos el formulario manualmente
                form.submit(); 
            } catch (err) {
                console.error("Error global en el envío:", err);
                alert("Ocurrió un problema al procesar las fotos. Por favor inténtalo de nuevo.");
                
                submitBtn.disabled = false;
                if (textSpan) {
                    textSpan.innerText = originalText;
                } else {
                    submitBtn.innerText = originalText;
                }
                isSubmitting = false;
            }
        });
    }
});
</script>
