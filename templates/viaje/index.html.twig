{% extends 'base.html.twig' %}

{% block title %}Explorar Viajes{% endblock %}

{% block body %}
<main class="max-w-6xl mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6">
        <div>
            <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-2 font-display">Explorar Viajes</h1>
            <p class="text-slate-500 text-lg">Descubre las mejores aventuras de la comunidad.</p>
        </div>
    </div>

    <!-- Buscador y Filtros -->
    <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-800 mb-10">
        <form method="get" action="{{ path('app_viaje_index') }}" class="grid grid-cols-1 md:grid-cols-4 gap-6 items-end">
            
            <!-- Buscador de lugar con Autocompletado manual -->
            <div class="relative">
                <label for="lugar" class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Lugar o destino</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
                        {{ ux_icon('lucide:map-pin', {'class': 'w-5 h-5'}) }}
                    </span>
                    <input type="text" id="lugar" name="lugar" value="{{ filters.lugar|default('') }}" autocomplete="off"
                           class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-all text-slate-800 bg-slate-50 dark:bg-slate-800 dark:border-slate-700 dark:text-white" 
                           placeholder="Ej. Madrid, París...">
                </div>
                <!-- Dropdown Autocomplete -->
                <div id="autocomplete-list" class="absolute z-50 w-full mt-1 bg-white border border-slate-200 rounded-xl shadow-lg empty:hidden hidden dark:bg-slate-800 dark:border-slate-700 overflow-hidden max-h-60 overflow-y-auto"></div>
            </div>

            <!-- Filtro Presupuesto con Rango -->
            <div>
                <label for="presupuesto" class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2 flex justify-between">
                    <span>Presupuesto Max.</span>
                    <span class="text-blue-600" id="presupuesto-output">{{ filters.presupuesto ? filters.presupuesto ~ ' €' : 'Cualquiera' }}</span>
                </label>
                <div class="py-2">
                    <input type="range" id="presupuesto" name="presupuesto" min="0" max="2500" step="50" 
                           value="{{ filters.presupuesto|default('2500') }}"
                           class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer dark:bg-slate-700 accent-blue-600"
                           oninput="document.getElementById('presupuesto-output').innerText = this.value >= 2500 ? 'Cualquiera' : this.value + ' €'; if(this.value>=2500){this.name='';}else{this.name='presupuesto';}">
                </div>
            </div>

            <!-- Filtro Días -->
            <div class="md:justify-self-center flex flex-col items-center">
                <label for="dias" class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2 text-center">Duración (Días)</label>
                <div class="flex items-stretch h-[46px] w-[130px] rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 overflow-hidden focus-within:border-blue-500 focus-within:ring-1 focus-within:ring-blue-500 transition-all shadow-sm">
                    <button type="button" onclick="document.getElementById('dias').stepDown()" class="px-3 md:px-4 bg-slate-50 hover:bg-slate-100 dark:bg-slate-800/50 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-400 border-r border-slate-200 dark:border-slate-700 transition-colors flex items-center justify-center outline-none">
                        {{ ux_icon('lucide:minus', {'class': 'w-4 h-4'}) }}
                    </button>
                    <input type="number" id="dias" name="dias" min="1" max="90" value="{{ filters.dias|default('') }}"
                           class="w-full text-center focus:outline-none text-slate-800 bg-transparent dark:text-white font-bold [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" 
                           placeholder="0">
                    <button type="button" onclick="document.getElementById('dias').stepUp()" class="px-3 md:px-4 bg-slate-50 hover:bg-slate-100 dark:bg-slate-800/50 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-400 border-l border-slate-200 dark:border-slate-700 transition-colors flex items-center justify-center outline-none">
                        {{ ux_icon('lucide:plus', {'class': 'w-4 h-4'}) }}
                    </button>
                </div>
            </div>

            <!-- Botones acción -->
            <div class="flex gap-2">
                {% if filters.presupuesto or filters.dias or filters.lugar %}
                    <a href="{{ path('app_viaje_index') }}" class="w-full text-center bg-slate-100 text-slate-600 px-4 py-3 rounded-xl font-bold hover:bg-slate-200 transition-colors shadow-sm dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">Limpiar</a>
                {% endif %}
                <button type="submit" class="w-full bg-blue-600 text-white px-6 py-3 rounded-xl font-bold hover:bg-blue-700 active:scale-95 transition-all shadow-sm flex items-center justify-center gap-2">
                    {{ ux_icon('lucide:search', {'class': 'w-5 h-5'}) }} Buscar
                </button>
            </div>
        </form>
    </div>

    <!-- Resultados -->
    {% if viajes|length == 0 %}
        <div class="text-center py-20 bg-slate-50 dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800">
            <span class="inline-block p-4 rounded-full bg-blue-50 text-blue-500 mb-4 dark:bg-blue-900/30">
                {{ ux_icon('lucide:map', {'class': 'w-10 h-10'}) }}
            </span>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">No se encontraron viajes</h3>
            <p class="text-slate-500 max-w-md mx-auto">No hemos encontrado nada que coincida con tus filtros. Prueba a buscar otro destino, con otra duración u otro presupuesto.</p>
            <a href="{{ path('app_viaje_index') }}" class="mt-6 inline-block text-blue-600 font-bold hover:underline">Ver todos los viajes</a>
        </div>
    {% else %}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {% for viaje in viajes %}
            {# LÓGICA DE PERSISTENCIA: Comprobación en el servidor #}
            {% set esFavorito = false %}
            {% if app.user %}
                {% for fav in viaje.favoritos %}
                    {% if fav.idUsuario and fav.idUsuario.id == app.user.id %}
                        {% set esFavorito = true %}
                    {% endif %}
                {% endfor %}
            {% endif %}

            <div class="group flex flex-col overflow-hidden rounded-xl bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-md dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                <div class="relative aspect-[16/10] overflow-hidden bg-slate-200">
                    <a href="{{ path('app_viaje_show', {'id': viaje.id}) }}" class="block w-full h-full">
                        {% if viaje.imagenes|length > 0 %}
                            <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" 
                                 alt="{{ viaje.titulo }}" 
                                 src="{{ path('app_imagen_viaje', {'filename': viaje.imagenes|first.urlPath}) }}"/>
                        {% else %}
                            <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" 
                                 alt="{{ viaje.titulo }}" 
                                 src="https://lh3.googleusercontent.com/aida-public/AB6AXuB_fabT81jRizmamsEUioeEM9bgPdIzCRrmoRJjnbu3a-aTHpxvjZ8dUN9nMGrjzAZq_OOlRnd6oTigO7ZUJK09A7wFcZRVnOQMlQd83Y6SIUTyCQQKWMpWrVgXuKYVN0oWTamrcDkY-9bn4kKzmclEx8pQPX1G85W5EIeBR6SppAVyh6UiB43b5CZ2JKE_gs3XLiC8MttQSPDnt5YwXPGN5PISN3M5m9jy4UDazk9fi-J9SUX1tT4kYr7Eg2m_btgfAGxOVThSAtYv"/>
                        {% endif %}
                    </a>
                    
                    {# BOTÓN DE FAVORITO #}
                    <a href="{{ path('app_favoritos_toggle', {'id': viaje.id}) }}" 
                       class="btn-favorito-toggle absolute right-3 top-3 z-10 rounded-full p-2 shadow-sm backdrop-blur transition-all 
                              {{ esFavorito ? 'bg-rose-500 text-white' : 'bg-white/90 text-rose-500 hover:bg-white dark:bg-slate-800/90' }}">
                        
                        <span class="icon-container">
                            {{ ux_icon('lucide:heart', {'class': 'w-5 h-5 ' ~ (esFavorito ? 'fill-current' : '')}) }}
                        </span>
                    </a>
                    
                    <div class="absolute left-3 top-3 rounded-lg bg-teal-600 px-3 py-1 text-xs font-bold text-white shadow-sm truncate max-w-[120px]">
                        {{ viaje.duracion }} Días
                    </div>
                </div>
                
                <div class="flex flex-1 flex-col p-5">
                    <a href="{{ path('app_viaje_show', {'id': viaje.id}) }}" class="flex-1">
                        <h3 class="text-lg font-bold leading-snug text-slate-900 group-hover:text-blue-600 transition-colors dark:text-white line-clamp-2" title="{{ viaje.titulo }}">
                            {{ viaje.titulo }}
                        </h3>
                    </a>
                    
                    <div class="mt-4 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="h-6 w-6 rounded-full bg-slate-200 overflow-hidden flex-shrink-0">
                                {% if viaje.idUsuario %}
                                    <img class="h-full w-full object-cover" 
                                         alt="{{ viaje.idUsuario.nickname }}" 
                                         src="{{ viaje.idUsuario.urlFotoPerfil|default('https://ui-avatars.com/api/?background=random&color=fff&name=' ~ viaje.idUsuario.nickname) }}"/>
                                {% else %}
                                    <div class="h-full w-full flex items-center justify-center text-xs text-slate-500 bg-slate-200">?</div>
                                {% endif %}
                            </div>
                            <span class="text-xs font-medium text-slate-500 dark:text-slate-400 truncate max-w-[100px]">
                                                {% if viaje.idUsuario %}
                                                     <a href="{{ path('app_usuario_show', {'id': viaje.idUsuario.id}) }}" class="hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white px-1.5 py-0.5 -ml-1.5 rounded transition-all duration-200">
                                                        by @{{ viaje.idUsuario.nickname }}
                                                     </a>
                                                {% else %}
                                                    by @Anónimo
                                                {% endif %}
                                        </span>
                        </div>
                        
                        <span class="text-xs font-semibold text-slate-400 flex items-center gap-1">
                            <span id="fav-icon-container-{{ viaje.id }}">
                                {{ ux_icon('lucide:heart', {'class': 'w-3 h-3 text-rose-500 ' ~ (viaje.favoritos|length > 0 ? 'fill-rose-500' : '')}) }}
                            </span>
                            <span id="fav-count-{{ viaje.id }}">{{ viaje.favoritos|length }}</span> 
                            <span id="fav-text-{{ viaje.id }}">{{ viaje.favoritos|length == 1 ? 'guardado' : 'guardados' }}</span>
                        </span>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    {% endif %}
</main>

<script>
// --- LÓGICA AUTOCOMPLETE ---
document.addEventListener('DOMContentLoaded', function() {
    const inputLugar = document.getElementById('lugar');
    const autocompleteList = document.getElementById('autocomplete-list');
    
    // Convertimos los destinos inyectados desde el controller a un set único y limpio
    // para autocompletado
    let destinos = [];
    try {
        destinos = JSON.parse('{{ destinos_json|raw }}');
    } catch(e) {}

    inputLugar.addEventListener('input', function() {
        let val = this.value;
        autocompleteList.innerHTML = '';
        
        if (!val) {
            autocompleteList.classList.add('hidden');
            return;
        }

        let hasResults = false;
        
        destinos.forEach(function(destino) {
            if (destino && destino.substr(0, val.length).toUpperCase() == val.toUpperCase()) {
                hasResults = true;
                const div = document.createElement('div');
                div.className = "px-4 py-3 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-medium transition-colors border-b border-slate-100 dark:border-slate-700 last:border-0";
                div.innerHTML = "<strong>" + destino.substr(0, val.length) + "</strong>" + destino.substr(val.length);
                
                div.addEventListener('click', function() {
                    inputLugar.value = destino;
                    autocompleteList.innerHTML = '';
                    autocompleteList.classList.add('hidden');
                });
                
                autocompleteList.appendChild(div);
            }
        });

        if (hasResults) {
            autocompleteList.classList.remove('hidden');
        } else {
            autocompleteList.classList.add('hidden');
        }
    });

    // Cerrar autocomplete al pinchar fuera
    document.addEventListener('click', function(e) {
        if (e.target !== inputLugar) {
            autocompleteList.innerHTML = '';
            autocompleteList.classList.add('hidden');
        }
    });
});

document.addEventListener('click', function(e) {
    const btn = e.target.closest('.btn-favorito-toggle');
    if (!btn) return;

    e.preventDefault(); 

    const url = btn.getAttribute('href');
    const viajeId = url.split('/').pop(); 
    
    const iconContainer = btn.querySelector('.icon-container');
    const countSpan = document.getElementById('fav-count-' + viajeId);
    const textSpan = document.getElementById('fav-text-' + viajeId);
    const footerIconContainer = document.getElementById('fav-icon-container-' + viajeId);

    // --- LÓGICA DE TIEMPO REAL ---
    let currentTotal = parseInt(countSpan.innerText);
    const wasFavorite = btn.classList.contains('bg-rose-500');

    if (wasFavorite) {
        // Quitar favorito (volver a neutro)
        btn.className = 'btn-favorito-toggle absolute right-3 top-3 z-10 rounded-full p-2 shadow-sm backdrop-blur transition-all bg-white/90 text-rose-500 hover:bg-white dark:bg-slate-800/90';
        iconContainer.innerHTML = '<svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>';
        currentTotal--;
    } else {
        // Poner favorito (Rojo)
        btn.className = 'btn-favorito-toggle absolute right-3 top-3 z-10 rounded-full p-2 shadow-sm backdrop-blur transition-all bg-rose-500 text-white';
        iconContainer.innerHTML = '<svg class="w-5 h-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>';
        currentTotal++;
    }

    // Actualizar números en la pantalla
    countSpan.innerText = currentTotal;
    if (textSpan) textSpan.innerText = currentTotal === 1 ? 'guardado' : 'guardados';
    
    // Corazón pequeño del footer
    if (footerIconContainer) {
        const footerSvg = footerIconContainer.querySelector('svg');
        currentTotal > 0 ? footerSvg.classList.add('fill-rose-500') : footerSvg.classList.remove('fill-rose-500');
    }

    // --- LLAMADA AL SERVIDOR ---
    fetch(url, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(response => response.json())
    .then(data => {
        // Sincronización final con DB
        const realTotal = data.totalFavoritos ?? data.count; 
        if (realTotal !== undefined) {
            countSpan.innerText = realTotal;
            if (textSpan) textSpan.innerText = realTotal === 1 ? 'guardado' : 'guardados';
        }
    })
    .catch(() => {
        // Si no está logueado o hay error, recargamos para que Symfony gestione la redirección
        window.location.reload();
    });
});

// --- SOLUCIÓN AL BOTÓN ATRÁS ERROR ---
window.onpageshow = function(event) {
    // Si la página se carga desde la caché (botón atrás), forzamos recarga limpia
    if (event.persisted || (window.performance && window.performance.navigation.type === 2)) {
        window.location.reload();
    }
};
</script>
{% endblock %}