{% extends 'base.html.twig' %}

{% block title %}Explorar Viajes{% endblock %}

{% block body %}
<main class="max-w-6xl mx-auto px-6 py-12">
    <div class="flex items-center justify-between mb-10">
        <div>
            <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-2 font-display">Explorar Viajes</h1>
            <p class="text-slate-500 text-lg">Descubre las mejores aventuras de la comunidad.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {% for viaje in viajes %}
            <!-- Card -->
            <div class="group flex flex-col overflow-hidden rounded-xl bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-md dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                <div class="relative aspect-[16/10] overflow-hidden">
                    <a href="{{ path('app_viaje_show', {'id': viaje.id}) }}" class="block w-full h-full">
                        <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" 
                             alt="{{ viaje.titulo }}" 
                             src="https://lh3.googleusercontent.com/aida-public/AB6AXuB_fabT81jRizmamsEUioeEM9bgPdIzCRrmoRJjnbu3a-aTHpxvjZ8dUN9nMGrjzAZq_OOlRnd6oTigO7ZUJK09A7wFcZRVnOQMlQd83Y6SIUTyCQQKWMpWrVgXuKYVN0oWTamrcDkY-9bn4kKzmclEx8pQPX1G85W5EIeBR6SppAVyh6UiB43b5CZ2JKE_gs3XLiC8MttQSPDnt5YwXPGN5PISN3M5m9jy4UDazk9fi-J9SUX1tT4kYr7Eg2m_btgfAGxOVThSAtYv"/>
                    </a>
                    
                    <!-- Botón de favoritos preparado -->
                    <div class="absolute right-3 top-3 rounded-full bg-white/90 p-2 text-rose-500 shadow-sm backdrop-blur dark:bg-slate-800/90 cursor-pointer hover:bg-white dark:hover:bg-slate-800 transition-colors">
                        {{ ux_icon('lucide:heart', {'class': 'w-5 h-5'}) }}
                    </div>
                    
                    <!-- Duración -->
                    <div class="absolute left-3 top-3 rounded-lg bg-teal-600 px-3 py-1 text-xs font-bold text-white shadow-sm truncate max-w-[120px]">
                        {{ viaje.duracion }} Días
                    </div>
                </div>
                
                <div class="flex flex-1 flex-col p-5">
                    <a href="{{ path('app_viaje_show', {'id': viaje.id}) }}" class="flex-1">
                        <h3 class="text-lg font-bold leading-snug text-slate-900 group-hover:text-blue-600 transition-colors dark:text-white line-clamp-2" title="{{ viaje.titulo }}">
                            {{ viaje.titulo }}
                        </h3>
                    </a>
                    
                    <div class="mt-4 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="h-6 w-6 rounded-full bg-slate-200 overflow-hidden flex-shrink-0">
                                {% if viaje.idUsuario %}
                                    <img class="h-full w-full object-cover" 
                                         alt="{{ viaje.idUsuario.nickname }}" 
                                         src="{{ viaje.idUsuario.urlFotoPerfil|default('https://ui-avatars.com/api/?background=random&color=fff&name=' ~ viaje.idUsuario.nickname) }}"/>
                                {% else %}
                                    <div class="h-full w-full flex items-center justify-center text-xs text-slate-500 bg-slate-200">?</div>
                                {% endif %}
                            </div>
                            <span class="text-xs font-medium text-slate-500 dark:text-slate-400 truncate max-w-[100px]">
                                by @{{ viaje.idUsuario ? viaje.idUsuario.nickname : 'Anónimo' }}
                            </span>
                        </div>
                        
                        <span class="text-xs font-semibold text-slate-400 flex items-center gap-1">
                            {{ ux_icon('lucide:heart', {'class': 'w-3 h-3 text-rose-500 fill-rose-500'}) }}
                            {{ viaje.favoritos|length }} {% if viaje.favoritos|length == 1 %}guardado{% else %}guardados{% endif %}
                        </span>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-span-full py-20 text-center text-slate-500">
                {{ ux_icon('lucide:map', {'class': 'w-16 h-16 mx-auto mb-4 text-slate-300'}) }}
                <p class="text-xl font-medium text-slate-600 mb-2">Aún no hay viajes para explorar</p>
                <p class="text-slate-400 mb-6">Sé la primera persona en compartir una gran aventura.</p>
                <a href="{{ path('app_viaje_new') }}" class="inline-flex bg-blue-600 text-white px-6 py-3 rounded-full font-bold shadow-md hover:bg-blue-700 transition-colors">
                    Crear mi primer viaje
                </a>
            </div>
        {% endfor %}
    </div>
</main>
{% endblock %}
