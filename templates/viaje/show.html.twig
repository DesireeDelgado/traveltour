{% extends 'base.html.twig' %}

{% block title %}{{ viaje.titulo }}{% endblock %}

{% block body %}
    <main class="min-h-screen bg-slate-100 pb-12">
        {# Main Image Header #}
        {% set header_bg = viaje.imagenes|length > 0 ? path('app_imagen_viaje', {'filename': viaje.imagenes[0].urlPath}) : 'https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1' %}
        <div class="relative h-[60vh] sm:h-[70vh] w-full bg-cover bg-center" style="background-image: url('{{ header_bg }}');">
            <div class="absolute inset-0 bg-black/40"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4">
                <div class="flex items-center space-x-2 text-white/90 mb-4 bg-black/30 px-4 py-2 rounded-full backdrop-blur-sm">
                    {{ ux_icon('lucide:map-pin', {'class': 'w-5 h-5'}) }}
                    <span class="font-medium tracking-wide uppercase text-sm">{{ viaje.destino }}</span>
                </div>
                <h1 class="text-4xl md:text-6xl font-extrabold text-white drop-shadow-lg mb-6">{{ viaje.titulo }}</h1>
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 relative z-10">
            <div class="flex flex-col lg:flex-row gap-8">
                
                {# Contenido Izquierda #}
                <div class="w-full lg:w-2/3 space-y-8">
                    <div class="bg-white rounded-2xl shadow-sm p-6 sm:p-10 border border-gray-100">
                        <section class="mb-10">
                            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                                {{ ux_icon('lucide:compass', {'class': 'w-6 h-6 mr-3 text-blue-600'}) }}
                                Experiencias
                            </h2>
                            <div class="prose prose-lg text-gray-600 max-w-none">
                                {{ viaje.contenido|nl2br }}
                            </div>
                        </section>

                        {% if viaje.alojamiento %}
                        <hr class="border-gray-100 my-8">
                        <section class="mb-10">
                            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                                {{ ux_icon('lucide:bed-double', {'class': 'w-6 h-6 mr-3 text-emerald-600'}) }}
                                Alojamiento
                            </h2>
                            <div class="prose prose-lg text-gray-600 max-w-none">{{ viaje.alojamiento|nl2br }}</div>
                        </section>
                        {% endif %}

                        {% if viaje.gastronomia %}
                        <hr class="border-gray-100 my-8">
                        <section class="mb-10">
                            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                                {{ ux_icon('lucide:utensils-crossed', {'class': 'w-6 h-6 mr-3 text-orange-600'}) }}
                                Gastronomía
                            </h2>
                            <div class="prose prose-lg text-gray-600 max-w-none">{{ viaje.gastronomia|nl2br }}</div>
                        </section>
                        {% endif %}

                        {% if viaje.imagenes|length > 0 %}
                        <hr class="border-gray-100 my-8">
                        <section class="mb-10">
                            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                                {{ ux_icon('lucide:image', {'class': 'w-6 h-6 mr-3 text-purple-600'}) }}
                                Galería de fotos
                            </h2>
                            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                                {% for imagen in viaje.imagenes %}
                                    <div class="aspect-square rounded-xl overflow-hidden shadow-sm border border-gray-100 bg-gray-50">
                                        <a href="{{ path('app_imagen_viaje', {'filename': imagen.urlPath}) }}" class="galeria-item block w-full h-full">
                                            <img src="{{ path('app_imagen_viaje', {'filename': imagen.urlPath}) }}" alt="Foto de {{ viaje.titulo }}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-pointer">
                                        </a>
                                    </div>
                                {% endfor %}
                            </div>
                        </section>
                        {% endif %}
                    </div>
                </div>

                {# Sidebar Derecha #}
                <div class="w-full lg:w-1/3 space-y-6">
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="bg-indigo-600 px-6 py-4">
                            <h3 class="text-xl font-bold text-white flex items-center">
                                {{ ux_icon('lucide:info', {'class': 'w-5 h-5 mr-2'}) }}
                                Detalles del viaje
                            </h3>
                        </div>
                        <div class="p-6 space-y-6">
                            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                <span class="text-gray-600 font-medium">Duración</span>
                                <span class="font-bold text-gray-900">{{ viaje.duracion }} Días</span>
                            </div>
                            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                <span class="text-gray-600 font-medium">Presupuesto</span>
                                <span class="font-bold text-gray-900">{{ viaje.presupuesto }} €</span>
                            </div>
                            
                            <div class="pt-4 space-y-3 border-t border-gray-100">
                                {# BOTÓN FAVORITO #}
                                <a href="{{ path('app_favoritos_toggle', {'id': viaje.id}) }}" 
                                   id="btn-favorito"
                                   class="w-full flex items-center justify-center space-x-2 py-3 px-4 rounded-xl font-medium transition-all active:scale-95 
                                   {{ isFavorito ? 'bg-blue-100 text-blue-700' : 'bg-rose-50 text-rose-600 hover:bg-rose-100' }}">
                                    
                                    <span id="fav-icon-container">
                                        {{ ux_icon('lucide:heart', {'class': 'w-5 h-5 ' ~ (isFavorito ? 'fill-blue-600 text-blue-600' : '')}) }}
                                    </span>
                                    
                                    <span id="fav-text">{{ isFavorito ? 'Guardado en favoritos' : 'Guardar en favoritos' }}</span>
                                </a>

                                <button class="w-full flex items-center justify-center space-x-2 bg-gray-50 text-gray-700 hover:bg-gray-100 py-3 px-4 rounded-xl font-medium transition-colors border border-gray-200">
                                    {{ ux_icon('lucide:share-2', {'class': 'w-5 h-5'}) }}
                                    <span>Compartir Itinerario</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    {# Widget Usuario #}
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 text-center">
                        {% set avatar_url = viaje.idUsuario.urlFotoPerfil|default('https://ui-avatars.com/api/?name=' ~ viaje.idUsuario.nickname|url_encode) %}
                        <img src="{{ avatar_url }}" class="w-24 h-24 mx-auto rounded-full object-cover border-4 border-indigo-50 mb-4">
                        <h3 class="text-xl font-bold text-gray-900">@{{ viaje.idUsuario.nickname }}</h3>
                        
                        <div class="mt-6 flex flex-col gap-3">
                            <a href="{{ path('app_usuario_show', {'id': viaje.idUsuario.id}) }}" class="inline-flex justify-center items-center py-2 px-4 border border-indigo-600 text-indigo-600 rounded-xl hover:bg-indigo-50 font-medium transition-colors">
                                {{ ux_icon('lucide:library', {'class': 'w-4 h-4 mr-2'}) }}
                                Ver viajes
                            </a>
                            
                            {% if app.user == viaje.idUsuario %}
                                <div class="grid grid-cols-2 gap-3 pt-4 border-t border-gray-100">
                                    <a href="{{ path('app_viaje_edit', {'id': viaje.id}) }}" class="bg-gray-100 text-gray-700 py-2 px-4 rounded-xl hover:bg-gray-200 text-center font-medium">Editar</a>
                                    <form method="post" action="{{ path('app_viaje_delete', {'id': viaje.id}) }}" onsubmit="return confirm('¿Seguro?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ viaje.id) }}">
                                        <button class="w-full bg-red-50 text-red-600 py-2 px-4 rounded-xl hover:bg-red-100 font-medium">Borrar</button>
                                    </form>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# =================== SECCIÓN DE COMENTARIOS =================== #}
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
            <div class="bg-white rounded-2xl shadow-sm p-6 sm:p-10 border border-gray-100">

                {# Título igual que el resto de secciones #}
                <h2 class="text-2xl font-bold text-gray-900 mb-8 flex items-center">
                    {{ ux_icon('lucide:message-square-text', {'class': 'w-6 h-6 mr-3 text-blue-600'}) }}
                    Comentarios
                    <span class="ml-3 bg-blue-50 text-blue-600 text-sm font-semibold px-3 py-1 rounded-full">
                        {{ viaje.comentarios|length }}
                    </span>
                </h2>

                {# ---- Formulario de nuevo comentario ---- #}
                {% if app.user %}
                    {{ form_start(comentarioForm, {
                        'action': path('app_viaje_comentar', {'id': viaje.id}),
                        'method': 'POST',
                        'attr': {'class': 'mb-10', 'id': 'comment-form'}
                    }) }}
                        {# Token de envío único: evita que el mismo formulario se procese más de una vez #}
                        <input type="hidden" name="comment_sid" value="{{ comment_sid }}">
                        {{ form_widget(comentarioForm.comentario, {
                            'attr': {
                                'rows': 5,
                                'placeholder': 'Comparte tu experiencia sobre este viaje...',
                                'class': 'block w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-700 placeholder-gray-400 transition-colors focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-400',
                                'style': 'min-height: 6rem; resize: vertical; box-sizing: border-box;'
                            }
                        }) }}
                        {{ form_errors(comentarioForm.comentario) }}
                        <div class="flex justify-end mt-3">
                            <button type="submit" id="btn-comentario-submit"
                                    class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-bold py-2.5 px-6 rounded-lg transition-all duration-200 shadow-md text-sm">
                                {{ ux_icon('lucide:send', {'class': 'w-4 h-4'}) }}
                                Publicar comentario
                            </button>
                        </div>
                    {{ form_end(comentarioForm) }}
                {% else %}
                    <div class="mb-10 bg-blue-50 border border-blue-100 rounded-xl px-6 py-4 flex items-center gap-3">
                        {{ ux_icon('lucide:lock', {'class': 'w-5 h-5 text-blue-400 flex-shrink-0'}) }}
                        <p class="text-blue-700 text-sm font-medium">
                            <a href="{{ path('app_login') }}" class="underline underline-offset-2 hover:text-blue-900 transition-colors">Inicia sesión</a>
                            para dejar un comentario.
                        </p>
                    </div>
                {% endif %}

                {# ---- Lista de comentarios ---- #}
                {% if viaje.comentarios|length > 0 %}
                    <div class="space-y-5">
                        {% for comentario in viaje.comentarios %}
                            {% set avatarUrl = comentario.idUsuario.urlFotoPerfil|default(
                                'https://ui-avatars.com/api/?name=' ~ comentario.idUsuario.nickname|url_encode ~ '&background=dbeafe&color=2563eb&bold=true'
                            ) %}
                            <div class="flex gap-4 group" id="comentario-{{ comentario.id }}">

                                {# Avatar clicable #}
                                <a href="{{ path('app_usuario_show', {'id': comentario.idUsuario.id}) }}"
                                   class="flex-shrink-0 mt-1">
                                    <img src="{{ avatarUrl }}"
                                         alt="@{{ comentario.idUsuario.nickname }}"
                                         class="w-11 h-11 rounded-full object-cover border-2 border-blue-100 hover:ring-2 hover:ring-blue-400 transition-all">
                                </a>

                                <div class="flex-1 bg-gray-50 rounded-2xl p-5 border border-gray-100 hover:border-blue-100 transition-colors duration-200">
                                    <div class="flex items-start justify-between gap-2 mb-2">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            {# Nickname clicable #}
                                            <a href="{{ path('app_usuario_show', {'id': comentario.idUsuario.id}) }}"
                                               class="font-semibold text-gray-900 hover:text-blue-600 transition-colors">
                                                @{{ comentario.idUsuario.nickname }}
                                            </a>
                                            {% if comentario.idUsuario == viaje.idUsuario %}
                                                <span class="inline-flex items-center gap-1 text-xs bg-blue-100 text-blue-700 font-medium px-2 py-0.5 rounded-full">
                                                    {{ ux_icon('lucide:crown', {'class': 'w-3 h-3'}) }} Autor del viaje
                                                </span>
                                            {% endif %}
                                            <span class="text-gray-300">·</span>
                                            <time class="text-gray-400 text-sm">
                                                {{ comentario.fechaCreacion|date('d/m/Y') }}
                                            </time>
                                        </div>

                                        {# Botón eliminar: solo autor del comentario O dueño del viaje #}
                                        {% if app.user and (app.user == comentario.idUsuario or app.user == viaje.idUsuario) %}
                                            <form method="post"
                                                  action="{{ path('app_comentario_delete', {'id': comentario.id}) }}"
                                                  onsubmit="return confirm('¿Seguro que quieres eliminar este comentario?');"
                                                  class="flex-shrink-0">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comentario.id) }}">
                                                <button type="submit"
                                                        title="Eliminar comentario"
                                                        class="opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity duration-200 p-2 rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50">
                                                    {{ ux_icon('lucide:trash-2', {'class': 'w-4 h-4'}) }}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                    <p class="text-gray-700 leading-relaxed">{{ comentario.comentario }}</p>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-10 text-gray-400">
                        {{ ux_icon('lucide:message-square-text', {'class': 'w-12 h-12 mx-auto mb-3 opacity-20'}) }}
                        <p class="font-medium">Aún no hay comentarios. ¡Sé el primero!</p>
                    </div>
                {% endif %}

            </div>
        </div>
        {# ============================================================= #}

    </main>

    {# JAVASCRIPT PARA NO RECARGAR LA PÁGINA #}
    <script>
        document.getElementById('btn-favorito').addEventListener('click', function(e) {
            e.preventDefault(); // Evita que la página se recargue
            const btn = this;
            const url = btn.getAttribute('href');
            const textSpan = document.getElementById('fav-text');
            const iconContainer = document.getElementById('fav-icon-container');

            fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.isFavorito) {
                    // Estado: Guardado (Azul)
                    btn.classList.remove('bg-rose-50', 'text-rose-600', 'hover:bg-rose-100');
                    btn.classList.add('bg-blue-100', 'text-blue-700');
                    textSpan.textContent = 'Guardado en favoritos';
                    // Cambiamos el icono a azul relleno manualmente (o con una clase)
                    iconContainer.innerHTML = `<svg class="w-5 h-5 fill-blue-600 text-blue-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`;
                } else {
                    // Estado: No guardado (Rojo original)
                    btn.classList.remove('bg-blue-100', 'text-blue-700');
                    btn.classList.add('bg-rose-50', 'text-rose-600', 'hover:bg-rose-100');
                    textSpan.textContent = 'Guardar en favoritos';
                    iconContainer.innerHTML = `<svg class="w-5 h-5 text-rose-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`;
                }
            })
            .catch(err => console.error('Error:', err));
        });
    </script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Fondo desenfocado y oscuro */
        .lum-backdrop {
            @apply bg-black/50 backdrop-blur-lg !important;
        }

        /* Forzar que las flechas aparezcan y sean blancas */
        .lum-next-button, .lum-previous-button {
            @apply text-white scale-[2] opacity-80 hover:opacity-100 transition-all !important;
            display: block !important;
        }

        /* Ajustar posición de las flechas para que no se peguen al borde */
        .lum-previous-button { left: 40px !important; }
        .lum-next-button { right: 40px !important; }

        /* Hacer que la imagen tenga bordes redondeados y sombra */
        .lum-lightbox-image {
            @apply rounded-2xl shadow-2xl border-4 border-white/10;
        }

        /* Textarea de comentario (CSS puro: @apply no funciona en bloques <style> de Twig) */
        #comment-form textarea {
            display: block;
            width: 100%;
            box-sizing: border-box;
            border: 1px solid #e5e7eb;
            border-radius: 0.75rem;
            background: #fff;
            padding: 0.75rem 1rem;
            font-size: 0.875rem;
            color: #374151;
            line-height: 1.625;
            resize: vertical;
            min-height: 6rem;
            transition: border-color .15s, box-shadow .15s;
        }
        #comment-form textarea:focus {
            outline: none;
            border-color: #60a5fa;
            box-shadow: 0 0 0 3px rgba(59,130,246,.2);
        }
        #comment-form textarea::placeholder { color: #9ca3af; }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // --- Galería Luminous ---
            const galleryElements = document.querySelectorAll('.galeria-item');
            if (galleryElements.length > 0) {
                new LuminousGallery(galleryElements, { arrowNavigation: true }, {
                    closeOnScroll: false, closeWithEscape: true
                });
            }

            // --- Prevenir doble envío del formulario de comentario ---
            const commentForm = document.getElementById('comment-form');
            if (commentForm) {
                commentForm.addEventListener('submit', function(e) {
                    const btn = document.getElementById('btn-comentario-submit');
                    if (btn) {
                        if (btn.dataset.submitting === '1') {
                            // Ya se está enviando: bloquear
                            e.preventDefault();
                            return false;
                        }
                        btn.dataset.submitting = '1';
                        btn.disabled = true;
                        btn.style.opacity = '0.7';
                        btn.style.cursor = 'not-allowed';
                        btn.innerHTML = '<svg class="w-4 h-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> Publicando...';
                    }
                });
            }

        });
    </script>
{% endblock %}