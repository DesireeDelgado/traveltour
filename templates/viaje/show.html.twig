{% extends 'base.html.twig' %}

{% block title %}{{ viaje.titulo }}{% endblock %}

{% block body %}
    <main class="min-h-screen bg-slate-100 pb-12">
        {# Main Image Header #}
        {% set header_bg = viaje.imagenes|length > 0 ? asset('uploads/images/' ~ viaje.imagenes[0].ruta) : 'https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1' %}
        <div class="relative h-[60vh] sm:h-[70vh] w-full bg-cover bg-center" style="background-image: url('{{ header_bg }}');">
            {# Overlay #}
            <div class="absolute inset-0 bg-black/40"></div>
            
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4">
                <div class="flex items-center space-x-2 text-white/90 mb-4 bg-black/30 px-4 py-2 rounded-full backdrop-blur-sm">
                    {{ ux_icon('lucide:map-pin', {'class': 'w-5 h-5'}) }}
                    <span class="font-medium tracking-wide uppercase text-sm">{{ viaje.destino }}</span>
                </div>
                <h1 class="text-4xl md:text-6xl font-extrabold text-white drop-shadow-lg mb-6">{{ viaje.titulo }}</h1>
            </div>
        </div>

        {# Content Container #}
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 relative z-10">
            <div class="flex flex-col lg:flex-row gap-8">
                
                {# Left Column - Main Content #}
                <div class="w-full lg:w-2/3 space-y-8">
                    <div class="bg-white rounded-2xl shadow-sm p-6 sm:p-10 border border-gray-100">
                        {# Experiencias #}
                        <section class="mb-10">
                            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                                {{ ux_icon('lucide:compass', {'class': 'w-6 h-6 mr-3 text-blue-600'}) }}
                                Experiencias
                            </h2>
                            <div class="prose prose-lg text-gray-600 max-w-none">
                                {{ viaje.contenido|nl2br }}
                            </div>
                        </section>

                        <hr class="border-gray-100 my-8">

                        {# Alojamiento #}
                        {% if viaje.alojamiento %}
                        <section class="mb-10">
                            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                                {{ ux_icon('lucide:bed-double', {'class': 'w-6 h-6 mr-3 text-emerald-600'}) }}
                                Alojamiento
                            </h2>
                            <div class="prose prose-lg text-gray-600 max-w-none">
                                {{ viaje.alojamiento|nl2br }}
                            </div>
                        </section>
                        <hr class="border-gray-100 my-8">
                        {% endif %}

                        {# Gastronomía #}
                        {% if viaje.gastronomia %}
                        <section class="mb-10">
                            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                                {{ ux_icon('lucide:utensils-crossed', {'class': 'w-6 h-6 mr-3 text-orange-600'}) }}
                                Gastronomía
                            </h2>
                            <div class="prose prose-lg text-gray-600 max-w-none">
                                {{ viaje.gastronomia|nl2br }}
                            </div>
                        </section>
                        <hr class="border-gray-100 my-8">
                        {% endif %}

                        {# Gallery Highlights #}
                        <section>
                            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                                {{ ux_icon('lucide:image', {'class': 'w-6 h-6 mr-3 text-purple-600'}) }}
                                Recuerdos del viaje
                            </h2>
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                                {% if viaje.imagenes|length > 0 %}
                                    {% for imagen in viaje.imagenes %}
                                        <div class="aspect-square rounded-xl overflow-hidden bg-gray-100">
                                            <img src="{{ asset('uploads/images/' ~ imagen.ruta) }}" alt="Gallery image" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300">
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    {# Static placeholders if no real images are in the gallery #}
                                    <div class="aspect-square rounded-xl overflow-hidden bg-gray-100">
                                        <img src="https://images.unsplash.com/photo-1501785888041-af3ef285b470" alt="Placeholder 1" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300">
                                    </div>
                                    <div class="aspect-square rounded-xl overflow-hidden bg-gray-100">
                                        <img src="https://images.unsplash.com/photo-1499856871958-5b9627545d1a" alt="Placeholder 2" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300">
                                    </div>
                                    <div class="aspect-square rounded-xl overflow-hidden bg-gray-100">
                                        <img src="https://images.unsplash.com/photo-1542640244-7e672d6cb466" alt="Placeholder 3" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300">
                                    </div>
                                {% endif %}
                            </div>
                        </section>
                    </div>
                </div>

                {# Right Column - Sidebar #}
                <div class="w-full lg:w-1/3 space-y-6">
                    {# Detalles del viaje #}
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="bg-indigo-600 px-6 py-4">
                            <h3 class="text-xl font-bold text-white flex items-center">
                                {{ ux_icon('lucide:info', {'class': 'w-5 h-5 mr-2'}) }}
                                Detalles del viaje
                            </h3>
                        </div>
                        <div class="p-6 space-y-6">
                            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                <div class="flex items-center text-gray-600">
                                    {{ ux_icon('lucide:clock', {'class': 'w-5 h-5 mr-3 text-indigo-500'}) }}
                                    <span class="font-medium">Duración</span>
                                </div>
                                <span class="font-bold text-gray-900">{{ viaje.duracion }} Días</span>
                            </div>
                            
                            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                <div class="flex items-center text-gray-600">
                                    {{ ux_icon('lucide:coins', {'class': 'w-5 h-5 mr-3 text-amber-500'}) }}
                                    <span class="font-medium">Presupuesto</span>
                                </div>
                                <span class="font-bold text-gray-900">{{ viaje.presupuesto }} €</span>
                            </div>
                            
                            <div class="pt-4 space-y-3 border-t border-gray-100">
                                <button class="w-full flex items-center justify-center space-x-2 bg-rose-50 text-rose-600 hover:bg-rose-100 py-3 px-4 rounded-xl font-medium transition-colors">
                                    {{ ux_icon('lucide:heart', {'class': 'w-5 h-5'}) }}
                                    <span>Guardar en favoritos</span>
                                </button>
                                <button class="w-full flex items-center justify-center space-x-2 bg-gray-50 text-gray-700 hover:bg-gray-100 py-3 px-4 rounded-xl font-medium transition-colors border border-gray-200">
                                    {{ ux_icon('lucide:share-2', {'class': 'w-5 h-5'}) }}
                                    <span>Compartir Itinerario</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    {# User Profile Widget #}
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 text-center">
                        {% set avatar_url = viaje.idUsuario.urlFotoPerfil|default('https://ui-avatars.com/api/?name=' ~ viaje.idUsuario.nickname|url_encode ~ '&background=random') %}
                        <img src="{{ avatar_url }}" alt="Avatar de {{ viaje.idUsuario.nickname }}" class="w-24 h-24 mx-auto rounded-full object-cover border-4 border-indigo-50 shadow-sm mb-4">
                        
                        <h3 class="text-xl font-bold text-gray-900">@{{ viaje.idUsuario.nickname }}</h3>
                        
                        {% if viaje.idUsuario.biografia %}
                            <p class="text-gray-500 text-sm mt-3 px-4">{{ viaje.idUsuario.biografia }}</p>
                        {% endif %}
                        
                        <div class="mt-6 flex flex-col gap-3">
                            <a href="{{ path('app_usuario_show', {'id': viaje.idUsuario.id}) }}" class="inline-flex justify-center items-center py-2 px-4 border border-indigo-600 text-indigo-600 rounded-xl hover:bg-indigo-50 font-medium transition-colors">
                                {{ ux_icon('lucide:library', {'class': 'w-4 h-4 mr-2'}) }}
                                Ver viajes
                            </a>
                            
                            {% if app.user == viaje.idUsuario %}
                                <div class="grid grid-cols-2 gap-3 pt-4 border-t border-gray-100">
                                    <a href="{{ path('app_viaje_edit', {'id': viaje.id}) }}" class="flex justify-center items-center py-2 px-4 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 font-medium transition-colors">
                                        {{ ux_icon('lucide:pencil', {'class': 'w-4 h-4 mr-2'}) }}
                                        Editar
                                    </a>
                                    
                                    <form method="post" action="{{ path('app_viaje_delete', {'id': viaje.id}) }}" onsubmit="return confirm('¿Estás seguro de que quieres borrar este viaje?');" class="w-full h-full">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ viaje.id) }}">
                                        <button class="w-full flex justify-center items-center py-2 px-4 bg-red-50 text-red-600 rounded-xl hover:bg-red-100 font-medium transition-colors">
                                            {{ ux_icon('lucide:trash-2', {'class': 'w-4 h-4 mr-2'}) }}
                                            Borrar
                                        </button>
                                    </form>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>
{% endblock %}
