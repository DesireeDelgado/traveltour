{% extends 'base.html.twig' %}

{% block title %}{{ viaje.titulo }}{% endblock %}

{% block body %}
    <main class="min-h-screen bg-slate-100 pb-12">
        {# Main Image Header #}
        {% set header_bg = viaje.imagenes|length > 0 ? asset('storage/viajes/' ~ viaje.imagenes[0].urlPath) : 'https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1' %}
        <div class="relative h-[60vh] sm:h-[70vh] w-full bg-cover bg-center" style="background-image: url('{{ header_bg }}');">
            <div class="absolute inset-0 bg-black/40"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4">
                <div class="flex items-center space-x-2 text-white/90 mb-4 bg-black/30 px-4 py-2 rounded-full backdrop-blur-sm">
                    {{ ux_icon('lucide:map-pin', {'class': 'w-5 h-5'}) }}
                    <span class="font-medium tracking-wide uppercase text-sm">{{ viaje.destino }}</span>
                </div>
                <h1 class="text-4xl md:text-6xl font-extrabold text-white drop-shadow-lg mb-6">{{ viaje.titulo }}</h1>
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 relative z-10">
            <div class="flex flex-col lg:flex-row gap-8">
                
                {# Contenido Izquierda #}
                <div class="w-full lg:w-2/3 space-y-8">
                    <div class="bg-white rounded-2xl shadow-sm p-6 sm:p-10 border border-gray-100">
                        <section class="mb-10">
                            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                                {{ ux_icon('lucide:compass', {'class': 'w-6 h-6 mr-3 text-blue-600'}) }}
                                Experiencias
                            </h2>
                            <div class="prose prose-lg text-gray-600 max-w-none">
                                {{ viaje.contenido|nl2br }}
                            </div>
                        </section>

                        {% if viaje.alojamiento %}
                        <hr class="border-gray-100 my-8">
                        <section class="mb-10">
                            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                                {{ ux_icon('lucide:bed-double', {'class': 'w-6 h-6 mr-3 text-emerald-600'}) }}
                                Alojamiento
                            </h2>
                            <div class="prose prose-lg text-gray-600 max-w-none">{{ viaje.alojamiento|nl2br }}</div>
                        </section>
                        {% endif %}

                        {% if viaje.gastronomia %}
                        <hr class="border-gray-100 my-8">
                        <section class="mb-10">
                            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                                {{ ux_icon('lucide:utensils-crossed', {'class': 'w-6 h-6 mr-3 text-orange-600'}) }}
                                Gastronomía
                            </h2>
                            <div class="prose prose-lg text-gray-600 max-w-none">{{ viaje.gastronomia|nl2br }}</div>
                        </section>
                        {% endif %}
                    </div>
                </div>

                {# Sidebar Derecha #}
                <div class="w-full lg:w-1/3 space-y-6">
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="bg-indigo-600 px-6 py-4">
                            <h3 class="text-xl font-bold text-white flex items-center">
                                {{ ux_icon('lucide:info', {'class': 'w-5 h-5 mr-2'}) }}
                                Detalles del viaje
                            </h3>
                        </div>
                        <div class="p-6 space-y-6">
                            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                <span class="text-gray-600 font-medium">Duración</span>
                                <span class="font-bold text-gray-900">{{ viaje.duracion }} Días</span>
                            </div>
                            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                <span class="text-gray-600 font-medium">Presupuesto</span>
                                <span class="font-bold text-gray-900">{{ viaje.presupuesto }} €</span>
                            </div>
                            
                            <div class="pt-4 space-y-3 border-t border-gray-100">
                                {# BOTÓN FAVORITO #}
                                <a href="{{ path('app_favoritos_toggle', {'id': viaje.id}) }}" 
                                   id="btn-favorito"
                                   class="w-full flex items-center justify-center space-x-2 py-3 px-4 rounded-xl font-medium transition-all active:scale-95 
                                   {{ isFavorito ? 'bg-blue-100 text-blue-700' : 'bg-rose-50 text-rose-600 hover:bg-rose-100' }}">
                                    
                                    <span id="fav-icon-container">
                                        {{ ux_icon('lucide:heart', {'class': 'w-5 h-5 ' ~ (isFavorito ? 'fill-blue-600 text-blue-600' : '')}) }}
                                    </span>
                                    
                                    <span id="fav-text">{{ isFavorito ? 'Guardado en favoritos' : 'Guardar en favoritos' }}</span>
                                </a>

                                <button class="w-full flex items-center justify-center space-x-2 bg-gray-50 text-gray-700 hover:bg-gray-100 py-3 px-4 rounded-xl font-medium transition-colors border border-gray-200">
                                    {{ ux_icon('lucide:share-2', {'class': 'w-5 h-5'}) }}
                                    <span>Compartir Itinerario</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    {# Widget Usuario #}
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 text-center">
                        {% set avatar_url = viaje.idUsuario.urlFotoPerfil|default('https://ui-avatars.com/api/?name=' ~ viaje.idUsuario.nickname|url_encode) %}
                        <img src="{{ avatar_url }}" class="w-24 h-24 mx-auto rounded-full object-cover border-4 border-indigo-50 mb-4">
                        <h3 class="text-xl font-bold text-gray-900">@{{ viaje.idUsuario.nickname }}</h3>
                        
                        <div class="mt-6 flex flex-col gap-3">
                            <a href="{{ path('app_usuario_show', {'id': viaje.idUsuario.id}) }}" class="inline-flex justify-center items-center py-2 px-4 border border-indigo-600 text-indigo-600 rounded-xl hover:bg-indigo-50 font-medium transition-colors">
                                {{ ux_icon('lucide:library', {'class': 'w-4 h-4 mr-2'}) }}
                                Ver viajes
                            </a>
                            
                            {% if app.user == viaje.idUsuario %}
                                <div class="grid grid-cols-2 gap-3 pt-4 border-t border-gray-100">
                                    <a href="{{ path('app_viaje_edit', {'id': viaje.id}) }}" class="bg-gray-100 text-gray-700 py-2 px-4 rounded-xl hover:bg-gray-200 text-center font-medium">Editar</a>
                                    <form method="post" action="{{ path('app_viaje_delete', {'id': viaje.id}) }}" onsubmit="return confirm('¿Seguro?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ viaje.id) }}">
                                        <button class="w-full bg-red-50 text-red-600 py-2 px-4 rounded-xl hover:bg-red-100 font-medium">Borrar</button>
                                    </form>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    {# JAVASCRIPT PARA NO RECARGAR LA PÁGINA #}
    <script>
        document.getElementById('btn-favorito').addEventListener('click', function(e) {
            e.preventDefault(); // Evita que la página se recargue
            const btn = this;
            const url = btn.getAttribute('href');
            const textSpan = document.getElementById('fav-text');
            const iconContainer = document.getElementById('fav-icon-container');

            fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.isFavorito) {
                    // Estado: Guardado (Azul)
                    btn.classList.remove('bg-rose-50', 'text-rose-600', 'hover:bg-rose-100');
                    btn.classList.add('bg-blue-100', 'text-blue-700');
                    textSpan.textContent = 'Guardado en favoritos';
                    // Cambiamos el icono a azul relleno manualmente (o con una clase)
                    iconContainer.innerHTML = `<svg class="w-5 h-5 fill-blue-600 text-blue-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`;
                } else {
                    // Estado: No guardado (Rojo original)
                    btn.classList.remove('bg-blue-100', 'text-blue-700');
                    btn.classList.add('bg-rose-50', 'text-rose-600', 'hover:bg-rose-100');
                    textSpan.textContent = 'Guardar en favoritos';
                    iconContainer.innerHTML = `<svg class="w-5 h-5 text-rose-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`;
                }
            })
            .catch(err => console.error('Error:', err));
        });
    </script>
{% endblock %}