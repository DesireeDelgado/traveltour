<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}TravelTour{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
        {% block stylesheets %}
            {{ vite_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ vite_entry_script_tags('app') }}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="flex flex-col min-h-screen bg-[#f4f8fb] text-[#111518]">
    
    {% block header %}
    <header class="sticky top-0 z-50 w-full border-b border-solid border-[#f0f3f4] bg-white/80 dark:bg-background-dark/80 backdrop-blur-md px-6 md:px-10 py-3">
        <div class="max-w-[1280px] mx-auto flex items-center justify-between gap-8 whitespace-nowrap">
            
            <div class="flex items-center gap-8">
                <a href="{{ path('app_viaje_index')|default('/') }}" class="flex items-center gap-4 text-primary hover:opacity-90 transition-opacity">
                    <img src="{{ asset('img/logo_traveltour.png') }}" alt="TravelTour Logo" class="h-9 w-auto">
                </a>
                
                <nav class="hidden lg:flex items-center gap-9">
                    <a class="text-[#111518] dark:text-white text-sm font-medium hover:text-blue-600 transition-colors" href="{{ path('app_dashboard') }}">Home</a>
                    <a class="text-[#111518] dark:text-white text-sm font-medium hover:text-blue-600 transition-colors" href="{{ path('app_viaje_index') }}">Viajes</a>
                    <a class="text-[#111518] dark:text-white text-sm font-medium hover:text-blue-600 transition-colors" href="{{ path('app_favoritos_index') }}">Mis Favoritos</a>
                </nav>
            </div>

            <div class="flex flex-1 justify-end gap-4 items-center">
                
                {# Buscador Escritorio #}
                <label class="hidden lg:flex flex-col min-w-40 !h-10 max-w-64">
                    <div class="flex w-full flex-1 items-stretch rounded-lg h-full bg-[#f0f3f4] dark:bg-slate-800">
                        <div class="text-[#617989] flex items-center justify-center pl-4">
                            <span class="material-symbols-outlined font-bold text-sm">Buscar</span>
                        </div>
                        <input class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-[#111518] dark:text-white focus:outline-0 focus:ring-0 border-none bg-transparent h-full px-4 rounded-l-none pl-2 text-base font-normal" value=""/>
                    </div>
                </label>

                {# Botón Nuevo Viaje Escritorio (Oculto en pantallas menores a lg) #}
                <a href="{{ path('app_viaje_new') }}" class="hidden lg:flex bg-blue-600 min-w-[84px] items-center justify-center rounded-lg h-10 px-4 text-white text-sm font-bold hover:bg-blue-700 transition-colors shadow-md">
                    Nuevo viaje
                </a>

                {% if app.user %}
                    {% set nav_avatar_url = app.user.urlFotoPerfil|default('https://ui-avatars.com/api/?name=' ~ app.user.nickname|url_encode) %}

                    <a href="{{ path('app_usuario_show', {'id': app.user.id}) }}" class="hidden lg:block">
                        <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10 border border-[#f0f3f4] transition-all hover:ring-2 hover:ring-blue-500/50" 
                             style='background-image: url("{{ nav_avatar_url }}");' title="Mi Perfil">
                        </div>
                    </a>

                    <a href="{{ path('app_logout') }}" title="Cerrar sesión" class="hidden lg:flex text-red-600 hover:text-red-700 items-center transition-colors">
                        {{ ux_icon('lucide:log-out', {'class': 'w-6 h-6'}) }}
                    </a>
                {% endif %}

                <button id="mobile-menu-btn" class="lg:hidden flex items-center justify-center p-2 text-gray-600 hover:text-gray-900 focus:outline-none">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>

        {# --- MENÚ DESPLEGABLE MÓVIL --- #}
        <div id="mobile-menu" class="hidden lg:hidden mt-4 pt-4 border-t border-gray-200">
            
            <div class="px-2 mb-4 w-full">
                <label class="flex flex-col w-full h-10">
                    <div class="flex w-full flex-1 items-stretch rounded-lg h-full bg-[#f0f3f4] dark:bg-slate-800">
                        <div class="text-[#617989] flex items-center justify-center pl-4">
                            <span class="material-symbols-outlined text-sm font-bold">Buscar</span>
                        </div>
                        <input class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-[#111518] dark:text-white focus:outline-0 focus:ring-0 border-none bg-transparent h-full px-4 rounded-l-none pl-2 text-base font-normal" placeholder="Ej. Madrid..." value=""/>
                    </div>
                </label>
            </div>
            
            <nav class="flex flex-col gap-4 text-center pb-4">
                <a class="text-[#111518] dark:text-white px-2 text-base font-medium hover:text-blue-600 block transition-colors" href="{{ path('app_dashboard') }}">Home</a>
                <a class="text-[#111518] dark:text-white px-2 text-base font-medium hover:text-blue-600 block transition-colors" href="{{ path('app_viaje_index') }}">Viajes</a>
                <a class="text-[#111518] dark:text-white px-2 text-base font-medium hover:text-blue-600 block transition-colors" href="{{ path('app_favoritos_index') }}">Mis Favoritos</a>
                
                {% if app.user %}
                    <a class="text-[#111518] dark:text-white px-2 text-base font-medium hover:text-blue-600 block transition-colors" href="{{ path('app_usuario_show', {'id': app.user.id}) }}">Mi Perfil</a>
                {% endif %}
                
                <div class="border-t border-gray-200 dark:border-slate-800 mt-2 pt-4 px-2 flex flex-col items-center gap-4">
                    <a href="{{ path('app_viaje_new') }}" class="bg-blue-600 text-center rounded-lg h-10 leading-10 text-white text-sm font-bold hover:bg-blue-700 w-full inline-block transition-colors">
                        Nuevo viaje
                    </a>
                    
                    {% if app.user %}
                        <a href="{{ path('app_logout') }}" class="text-red-600 text-base font-bold hover:text-red-800 transition-colors">
                            Cerrar sesión
                        </a>
                    {% endif %}
                </div>
            </nav>
        </div>
    </header>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const btn = document.getElementById('mobile-menu-btn');
            const menu = document.getElementById('mobile-menu');
            if (btn && menu) {
                btn.addEventListener('click', function() {
                    menu.classList.toggle('hidden');
                });
            }
        });
    </script>
    {% endblock %}

    <main class="flex-1">
        {% block body %}{% endblock %}
    </main>

    <footer class="w-full bg-white dark:bg-slate-900 border-t border-[#f0f3f4] dark:border-slate-800">
    <div class="max-w-[1280px] mx-auto px-10 py-8"> 
        <div class="flex flex-wrap justify-center gap-12 text-center md:text-left">

            <div class="w-full md:w-auto md:max-w-[300px] flex flex-col items-center md:items-start">
                <div class="flex items-center gap-3 mb-6">
                    <img src="{{ asset('img/logo_traveltour.png') }}" alt="TravelTour Logo" class="h-10 w-auto">
                </div>
                <p class="text-[#617989] text-sm">La comunidad más grande del mundo de itinerarios de viaje auténticos y basados en experiencias.</p>
            </div>

            <div class="min-w-[150px]">
                <h4 class="font-bold mb-4 text-[#111518] dark:text-white">Plataforma</h4>
                <ul class="space-y-2 text-sm text-[#617989]">
                    {# Estos enlaces forzarán el login si la ruta está protegida en security.yaml #}
                    <li><a class="hover:text-blue-600 transition-colors" href="{{ path('app_viaje_index') }}">Explorar Viajes</a></li>
                    <li><a class="hover:text-blue-600 transition-colors" href="{{ path('app_viaje_new') }}">Publicar Ruta</a></li>
                    <li><a class="hover:text-blue-600 transition-colors" href="{{ path('app_favoritos_index') }}">Mis Favoritos</a></li>
                </ul>
            </div>

            <div class="min-w-[150px]">
                <h4 class="font-bold mb-4 text-[#111518] dark:text-white">Soporte</h4>
                <ul class="space-y-2 text-sm text-[#617989]">
                    <li><a class="hover:text-blue-600 transition-colors" href="https://www.incibe.es/ciudadania/formacion/guias/guia-de-privacidad-y-seguridad-en-internet">Seguridad</a></li>
                    <li><a class="hover:text-blue-600 transition-colors" href="https://es.wikipedia.org/wiki/Política_de_privacidad">Política de privacidad</a></li>
                    <li><a class="hover:text-blue-600 transition-colors" href="https://es.wikipedia.org/wiki/Términos_de_servicio">Términos del servicio</a></li>
                </ul>
            </div>

        </div>
        <div class="border-t border-[#f0f3f4] dark:border-slate-800 mt-8 pt-6 text-center text-sm text-[#617989]">
            © {{ "now"|date("Y") }} TravelTour. Todos los derechos reservados.
        </div>
    </div>
</footer>
    </body>
</html>