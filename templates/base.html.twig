<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}TravelTour{% endblock %}</title>
        <link rel="icon" href="{{ asset('img/icon_logo.png') }}">
        
        <!-- Scripts y CDNs externos que deben cargar antes que los bloques base de JS -->
        <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/browser-image-compression@2.0.2/dist/browser-image-compression.js"></script>


        {% block stylesheets %}
            {{ vite_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ vite_entry_script_tags('app') }}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="flex flex-col min-h-screen bg-[#f4f8fb] text-[#111518]">
    
    {% block header %}
    <header class="sticky top-0 z-50 w-full border-b border-solid border-[#f0f3f4] bg-white/80 dark:bg-background-dark/80 backdrop-blur-md px-6 md:px-10 py-3">
        <div class="max-w-[1280px] mx-auto flex items-center justify-between gap-8 whitespace-nowrap">
            
            <div class="flex items-center gap-8">
                <a href="{{ path('app_viaje_index')|default('/') }}" class="flex items-center gap-4 text-primary hover:opacity-90 transition-opacity">
                    <img src="{{ asset('img/logo_traveltour.png') }}" alt="TravelTour Logo" class="h-9 w-auto">
                </a>
                
                <nav class="hidden lg:flex items-center gap-9">
                    <a class="text-[#111518] dark:text-white text-sm font-medium hover:text-blue-600 transition-colors" href="{{ path('app_dashboard') }}">Home</a>
                    <a class="text-[#111518] dark:text-white text-sm font-medium hover:text-blue-600 transition-colors" href="{{ path('app_viaje_index') }}">Viajes</a>
                    <a class="text-[#111518] dark:text-white text-sm font-medium hover:text-blue-600 transition-colors" href="{{ path('app_favoritos_index') }}">Mis Favoritos</a>
                </nav>
            </div>

            <div class="flex flex-1 justify-end gap-4 items-center">
                
                {# Buscador Escritorio #}
                <div class="hidden lg:flex flex-col min-w-40 max-w-64 relative" id="search-wrapper-desktop">
                    <div class="flex w-full flex-1 items-stretch rounded-lg h-10 bg-[#f0f3f4] dark:bg-slate-800">
                        <div class="text-[#617989] flex items-center justify-center pl-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                        </div>
                        <input
                            id="search-input-desktop"
                            class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-[#111518] dark:text-white focus:outline-0 focus:ring-0 border-none bg-transparent h-full px-4 rounded-l-none pl-2 text-base font-normal"
                            placeholder="Buscar destino o usuario..."
                            autocomplete="off"
                            value=""
                        />
                    </div>
                    <div id="autocomplete-dropdown-desktop" class="absolute top-full left-0 right-0 mt-1 bg-white dark:bg-slate-800 rounded-xl shadow-xl border border-gray-200 dark:border-slate-700 z-50 hidden overflow-hidden"></div>
                </div>

                {# Botón Nuevo Viaje Escritorio (Oculto en pantallas menores a lg) #}
                <a href="{{ path('app_viaje_new') }}" class="hidden lg:flex bg-blue-600 min-w-[84px] items-center justify-center rounded-lg h-10 px-4 text-white text-sm font-bold hover:bg-blue-700 transition-colors shadow-md">
                    Nuevo viaje
                </a>

                {% if app.user %}
                    {# CAMPANA DE NOTIFICACIONES #}
                    {% set unread_notifications = app.user.notificaciones|filter(n => not n.leido) %}
                    <div class="relative flex items-center" id="notification-bell">
                        <button id="notification-btn" class="relative p-2 text-gray-600 hover:text-blue-600 dark:text-gray-300 dark:hover:text-white transition-colors focus:outline-none">
                            {{ ux_icon('tabler:bell', {class: 'w-6 h-6'}) }}
                            {% if unread_notifications|length > 0 %}
                                <span class="absolute top-1 right-1 flex h-4 w-4 items-center justify-center rounded-full bg-red-500 text-[10px] font-bold text-white">
                                    {{ unread_notifications|length }}
                                </span>
                            {% endif %}
                        </button>
                        
                        <div id="notification-dropdown" class="absolute right-0 top-full mt-2 w-72 sm:w-80 bg-white dark:bg-slate-800 rounded-xl shadow-xl border border-gray-200 dark:border-slate-700 z-50 hidden overflow-hidden">
                            <div class="px-4 py-3 border-b border-gray-100 dark:border-slate-700 bg-gray-50 dark:bg-slate-800/80">
                                <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Notificaciones</h3>
                            </div>
                            <div class="max-h-80 overflow-y-auto">
                                {% if app.user.notificaciones|length > 0 %}
                                    {% for notif in app.user.notificaciones|sort((a, b) => b.createdAt <=> a.createdAt) %}
                                        <a href="{{ path('app_notificacion_leer', {id: notif.id}) }}" class="block px-4 py-3 hover:bg-gray-50 dark:hover:bg-slate-700 border-b border-gray-100 dark:border-slate-700 transition-colors whitespace-normal {{ not notif.leido ? 'bg-blue-50/50 dark:bg-blue-900/20' : '' }}">
                                            <p class="text-sm text-gray-800 dark:text-gray-200 break-words leading-tight">{{ notif.mensaje|raw }}</p>
                                            <p class="text-[11px] text-gray-500 mt-1">{{ notif.createdAt|date('d/m/Y H:i','Europe/Madrid') }}</p>
                                        </a>
                                    {% endfor %}
                                    <div class="px-4 py-3 bg-gray-50 dark:bg-slate-800/80 sticky bottom-0 border-t border-gray-100 dark:border-slate-700 block" id="form-limpiar-wrapper">
                                        <form id="form-limpiar-notificaciones" action="{{ path('app_notificacion_limpiar') }}" method="POST">
                                            <input type="hidden" name="_token" value="{{ csrf_token('limpiar_notificaciones') }}">
                                            <button type="submit" class="w-full flex items-center justify-center gap-2 text-sm text-red-600 hover:text-red-700 font-medium transition-colors">
                                                {{ ux_icon('tabler:trash', {class: 'w-4 h-4'}) }}
                                                Limpiar notificaciones
                                            </button>
                                        </form>
                                    </div>
                                {% else %}
                                    <p class="px-4 py-8 text-sm text-center text-gray-500 dark:text-gray-400">No tienes notificaciones</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    {% set nav_avatar_url = app.user.urlFotoPerfil|default('https://ui-avatars.com/api/?name=' ~ app.user.nickname|url_encode) %}

                    <a href="{{ path('app_usuario_show', {'id': app.user.id}) }}" class="hidden lg:block">
                        <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10 border border-[#f0f3f4] transition-all hover:ring-2 hover:ring-blue-500/50" 
                             style='background-image: url("{{ nav_avatar_url }}");' title="Mi Perfil">
                        </div>
                    </a>

                    <a href="{{ path('app_logout') }}" title="Cerrar sesión" class="hidden lg:flex text-red-600 hover:text-red-700 items-center transition-colors">
                        {{ ux_icon('lucide:log-out', {'class': 'w-6 h-6'}) }}
                    </a>
                {% endif %}

                <button id="mobile-menu-btn" class="lg:hidden flex items-center justify-center p-2 text-gray-600 hover:text-gray-900 focus:outline-none">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>

        {# --- MENÚ DESPLEGABLE MÓVIL --- #}
        <div id="mobile-menu" class="hidden lg:hidden mt-4 pt-4 border-t border-gray-200">
            
            <div class="px-2 mb-4 w-full relative" id="search-wrapper-mobile">
                <div class="flex w-full flex-1 items-stretch rounded-lg h-10 bg-[#f0f3f4] dark:bg-slate-800">
                    <div class="text-[#617989] flex items-center justify-center pl-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </div>
                    <input
                        id="search-input-mobile"
                        class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-[#111518] dark:text-white focus:outline-0 focus:ring-0 border-none bg-transparent h-full px-4 rounded-l-none pl-2 text-base font-normal"
                        placeholder="Buscar destino o usuario..."
                        autocomplete="off"
                        value=""
                    />
                </div>
                <div id="autocomplete-dropdown-mobile" class="absolute top-full left-0 right-0 mt-1 bg-white dark:bg-slate-800 rounded-xl shadow-xl border border-gray-200 dark:border-slate-700 z-50 hidden overflow-hidden"></div>
            </div>
            
            <nav class="flex flex-col gap-4 text-center pb-4">
                <a class="text-[#111518] dark:text-white px-2 text-base font-medium hover:text-blue-600 block transition-colors" href="{{ path('app_dashboard') }}">Home</a>
                <a class="text-[#111518] dark:text-white px-2 text-base font-medium hover:text-blue-600 block transition-colors" href="{{ path('app_viaje_index') }}">Viajes</a>
                <a class="text-[#111518] dark:text-white px-2 text-base font-medium hover:text-blue-600 block transition-colors" href="{{ path('app_favoritos_index') }}">Mis Favoritos</a>
                
                {% if app.user %}
                    <a class="text-[#111518] dark:text-white px-2 text-base font-medium hover:text-blue-600 block transition-colors" href="{{ path('app_usuario_show', {'id': app.user.id}) }}">Mi Perfil</a>
                {% endif %}
                
                <div class="border-t border-gray-200 dark:border-slate-800 mt-2 pt-4 px-2 flex flex-col items-center gap-4">
                    <a href="{{ path('app_viaje_new') }}" class="bg-blue-600 text-center rounded-lg h-10 leading-10 text-white text-sm font-bold hover:bg-blue-700 w-full inline-block transition-colors">
                        Nuevo viaje
                    </a>
                    
                    {% if app.user %}
                        <a href="{{ path('app_logout') }}" class="text-red-600 text-base font-bold hover:text-red-800 transition-colors">
                            Cerrar sesión
                        </a>
                    {% endif %}
                </div>
            </nav>
        </div>
    </header>

    <script>
    (function () {
        const AUTOCOMPLETE_URL = '{{ path('app_search_autocomplete') }}';
        const VIAJES_URL       = '{{ path('app_viaje_index') }}';

        /* ── Menú móvil ───────────────────────────────────────────── */
        document.addEventListener('DOMContentLoaded', function () {
            const btn  = document.getElementById('mobile-menu-btn');
            const menu = document.getElementById('mobile-menu');
            if (btn && menu) {
                btn.addEventListener('click', () => menu.classList.toggle('hidden'));
            }

            setupAutocomplete('search-input-desktop', 'autocomplete-dropdown-desktop');
            setupAutocomplete('search-input-mobile',  'autocomplete-dropdown-mobile');

            /* Lógica de Notificaciones */
            const notifBtn = document.getElementById('notification-btn');
            const notifDropdown = document.getElementById('notification-dropdown');
            if (notifBtn && notifDropdown) {
                notifBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    notifDropdown.classList.toggle('hidden');
                });
                document.addEventListener('click', function(e) {
                    if (!notifDropdown.contains(e.target) && !notifBtn.contains(e.target)) {
                        notifDropdown.classList.add('hidden');
                    }
                });
            }
            // Lógica para limpiar notificaciones
            const formLimpiar = document.getElementById('form-limpiar-notificaciones');
            if (formLimpiar) {
                formLimpiar.addEventListener('submit', function(e) {
                    e.preventDefault();
                    if (!confirm('¿Seguro que quieres borrar todas tus notificaciones?')) {
                        return;
                    }
                    
                    fetch(this.action, {
                        method: 'POST',
                        body: new FormData(this)
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            const notifContainer = notifDropdown.querySelector('.max-h-80');
                            if (notifContainer) {
                                notifContainer.innerHTML = '<p class="px-4 py-8 text-sm text-center text-gray-500 dark:text-gray-400">No tienes notificaciones</p>';
                            }
                            const badge = notifBtn.querySelector('span.bg-red-500');
                            if (badge) {
                                badge.remove();
                            }
                        }
                    })
                    .catch(() => {});
                });
            }
        });

        /* ── Helpers ──────────────────────────────────────────────── */
        function escapeHtml(str) {
            const d = document.createElement('div');
            d.appendChild(document.createTextNode(str));
            return d.innerHTML;
        }

        function updateActive(items, idx) {
            items.forEach((el, i) => {
                el.classList.toggle('bg-blue-50', i === idx);
                el.classList.toggle('dark:bg-slate-700', i === idx);
            });
        }

        /* ── Renderizado del dropdown ─────────────────────────────── */
        function renderDropdown(data, dropdown, inputEl) {
            if (!data.length) {
                dropdown.innerHTML = '<div class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400">No se encontraron resultados</div>';
                dropdown.classList.remove('hidden');
                return;
            }

            const destinos = data.filter(s => s.type === 'destino');
            const usuarios = data.filter(s => s.type === 'usuario');
            let html = '';

            if (destinos.length) {
                html += '<p class="px-3 pt-2 pb-1 text-xs font-semibold text-gray-400 uppercase tracking-wider">Destinos</p>';
                destinos.forEach(s => {
                    html += `
                    <a href="${s.url}" class="autocomplete-item flex items-center gap-3 px-4 py-2.5 hover:bg-blue-50 dark:hover:bg-slate-700 transition-colors">
                        <span class="flex-shrink-0 w-7 h-7 bg-blue-100 dark:bg-blue-900/40 rounded-full flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                        </span>
                        <span class="text-sm text-gray-800 dark:text-white font-medium">${escapeHtml(s.label)}</span>
                        <span class="ml-auto text-xs text-gray-400">Destino</span>
                    </a>`;
                });
            }

            if (usuarios.length) {
                if (destinos.length) html += '<div class="border-t border-gray-100 dark:border-slate-700 my-1"></div>';
                html += '<p class="px-3 pt-1 pb-1 text-xs font-semibold text-gray-400 uppercase tracking-wider">Usuarios</p>';
                usuarios.forEach(s => {
                    html += `
                    <a href="${s.url}" class="autocomplete-item flex items-center gap-3 px-4 py-2.5 hover:bg-blue-50 dark:hover:bg-slate-700 transition-colors">
                        <img src="${escapeHtml(s.avatar)}" alt="${escapeHtml(s.label)}" class="flex-shrink-0 w-7 h-7 rounded-full object-cover bg-gray-200" onerror="this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(s.label)}&background=dbeafe&color=2563eb'">
                        <span class="text-sm text-gray-800 dark:text-white font-medium">${escapeHtml(s.label)}</span>
                        <span class="ml-auto text-xs text-gray-400">Usuario</span>
                    </a>`;
                });
            }

            const q = escapeHtml(inputEl.value.trim());
            const qRaw = encodeURIComponent(inputEl.value.trim());
            html += `
            <div class="border-t border-gray-100 dark:border-slate-700 mt-1"></div>
            <a href="${VIAJES_URL}?lugar=${qRaw}" class="autocomplete-item flex items-center gap-2 px-4 py-2.5 text-sm text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-slate-700 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                Buscar <strong class="mx-1">&ldquo;${q}&rdquo;</strong> en todos los viajes
            </a>`;

            dropdown.innerHTML = html;
            dropdown.classList.remove('hidden');
        }

        /* ── Setup por input ──────────────────────────────────────── */
        function setupAutocomplete(inputId, dropdownId) {
            const input    = document.getElementById(inputId);
            const dropdown = document.getElementById(dropdownId);
            if (!input || !dropdown) return;

            let timer;
            let currentIdx = -1;
            let lastData   = [];

            input.addEventListener('input', function () {
                clearTimeout(timer);
                currentIdx = -1;
                const q = this.value.trim();
                if (!q) { dropdown.classList.add('hidden'); dropdown.innerHTML = ''; return; }

                timer = setTimeout(() => {
                    fetch(AUTOCOMPLETE_URL + '?q=' + encodeURIComponent(q))
                        .then(r => r.json())
                        .then(data => { lastData = data; renderDropdown(data, dropdown, input); })
                        .catch(() => {});
                }, 220);
            });

            input.addEventListener('keydown', function (e) {
                const items = dropdown.querySelectorAll('.autocomplete-item');
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    currentIdx = Math.min(currentIdx + 1, items.length - 1);
                    updateActive(items, currentIdx);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    currentIdx = Math.max(currentIdx - 1, -1);
                    updateActive(items, currentIdx);
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (currentIdx >= 0 && lastData[currentIdx]) {
                        window.location.href = lastData[currentIdx].url;
                    } else if (this.value.trim()) {
                        window.location.href = VIAJES_URL + '?lugar=' + encodeURIComponent(this.value.trim());
                    }
                } else if (e.key === 'Escape') {
                    dropdown.classList.add('hidden');
                    currentIdx = -1;
                }
            });

            /* Cerrar al hacer click fuera */
            document.addEventListener('click', function (e) {
                if (!input.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.classList.add('hidden');
                    currentIdx = -1;
                }
            });
        }
    })();
    </script>
    {% endblock %}

    <main class="flex-1">
    {#mostras mensajes flash#}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="max-w-[1280px] mx-auto px-6 mt-4">
                    <div class="p-4 mb-4 text-sm {% if label == 'success' %}text-green-800 bg-green-50 border border-green-200{% elseif label == 'error' %}text-red-800 bg-red-50 border border-red-200{% else %}text-blue-800 bg-blue-50 border border-blue-200{% endif %} rounded-lg" role="alert">
                        {{ message }}
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>

    <footer class="w-full bg-white dark:bg-slate-900 border-t border-[#f0f3f4] dark:border-slate-800">
    <div class="max-w-[1280px] mx-auto px-10 py-8"> 
        <div class="flex flex-wrap justify-center gap-12 text-center md:text-left">

            <div class="w-full md:w-auto md:max-w-[300px] flex flex-col items-center md:items-start">
                <div class="flex items-center gap-3 mb-6">
                    <img src="{{ asset('img/logo_traveltour.png') }}" alt="TravelTour Logo" class="h-10 w-auto">
                </div>
                <p class="text-[#617989] text-sm">La comunidad más grande del mundo de itinerarios de viaje auténticos y basados en experiencias.</p>
            </div>

            <div class="min-w-[150px]">
                <h4 class="font-bold mb-4 text-[#111518] dark:text-white">Plataforma</h4>
                <ul class="space-y-2 text-sm text-[#617989]">
                    {# Estos enlaces forzarán el login si la ruta está protegida en security.yaml #}
                    <li><a class="hover:text-blue-600 transition-colors" href="{{ path('app_viaje_index') }}">Explorar Viajes</a></li>
                    <li><a class="hover:text-blue-600 transition-colors" href="{{ path('app_viaje_new') }}">Publicar Ruta</a></li>
                    <li><a class="hover:text-blue-600 transition-colors" href="{{ path('app_favoritos_index') }}">Mis Favoritos</a></li>
                </ul>
            </div>

            <div class="min-w-[150px]">
                <h4 class="font-bold mb-4 text-[#111518] dark:text-white">Soporte</h4>
                <ul class="space-y-2 text-sm text-[#617989]">
                    <li><a class="hover:text-blue-600 transition-colors" href="https://www.incibe.es/ciudadania/formacion/guias/guia-de-privacidad-y-seguridad-en-internet">Seguridad</a></li>
                    <li><a class="hover:text-blue-600 transition-colors" href="https://es.wikipedia.org/wiki/Política_de_privacidad">Política de privacidad</a></li>
                    <li><a class="hover:text-blue-600 transition-colors" href="https://es.wikipedia.org/wiki/Términos_de_servicio">Términos del servicio</a></li>
                </ul>
            </div>

        </div>
        <div class="border-t border-[#f0f3f4] dark:border-slate-800 mt-8 pt-6 text-center text-sm text-[#617989]">
            © {{ "now"|date("Y") }} TravelTour. Todos los derechos reservados.
        </div>
    </div>
</footer>
    </body>
</html>