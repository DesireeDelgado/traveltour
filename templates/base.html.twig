<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}TravelTour{% endblock %}</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            {{ vite_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ vite_entry_script_tags('app') }}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="flex flex-col min-h-screen">
    {% block header %}
    <header class="sticky top-0 z-50 w-full border-b border-solid border-[#f0f3f4] bg-white/80 dark:bg-background-dark/80 backdrop-blur-md px-6 md:px-10 py-3">
        <div class="max-w-[1280px] mx-auto flex items-center justify-between gap-8 whitespace-nowrap">
            <div class="flex items-center gap-8">
                <div class="flex items-center gap-4 text-primary">
                    <h2 class="text-[#111518] dark:text-white text-xl font-bold leading-tight tracking-[-0.015em]">TravelTour</h2>
                </div>
                <nav class="hidden lg:flex items-center gap-9">
                    <a class="text-[#111518] dark:text-white text-sm font-medium leading-normal hover:text-primary transition-colors" href="{{ path( 'app_viaje_index') }}">Home</a>
                    <a class="text-[#111518] dark:text-white text-sm font-medium leading-normal hover:text-primary transition-colors" href="{{ path( 'app_viaje_index') }}">Itinerarios</a>
                    <a class="text-[#111518] dark:text-white text-sm font-medium leading-normal hover:text-primary transition-colors" href="{{ path('app_favoritos_index') }}">Mis Favoritos</a>
                </nav>
            </div>
            <div class="flex flex-1 justify-end gap-4 items-center">
                <label class="hidden sm:flex flex-col min-w-40 !h-10 max-w-64">
                    <div class="flex w-full flex-1 items-stretch rounded-lg h-full">
                        <div class="text-[#617989] flex border-none bg-[#f0f3f4] dark:bg-slate-800 items-center justify-center pl-4 rounded-l-lg" data-icon="MagnifyingGlass">
                            <span class="material-symbols-outlined">Buscar</span>
                        </div>
                        <input class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-[#111518] dark:text-white focus:outline-0 focus:ring-0 border-none bg-[#f0f3f4] dark:bg-slate-800 focus:border-none h-full placeholder:text-[#617989] px-4 rounded-l-none pl-2 text-base font-normal" value=""/>
                    </div>
                </label>
                <a href="{{ path( 'app_viaje_new') }}" class="bg-sky-500 flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold leading-normal tracking-[0.015em] hover:opacity-90 transition-opacity">
                    <span class="truncate">Crear itinerario</span>
                </a>
                <a href="{{ path('app_usuario_index') }}">
                    <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10 border border-[#f0f3f4]" data-alt="User profile avatar" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuDKPcoBHWng9b8rm9gSFAZs_3hlgRppa516Jycm-to77f8fLSwEPmYMVdcAnerQrFom8eEX6gh-27OUjD7dd80oMP1ebsw1usD7zZgUjrjvMSAqMYp9QfUtGRCjl5DMKYHHtQpp94qJ41xo40O4n4dDpY3HhDZH6UdgfHWgpG7wpQ9T2SsOukEMYZ6tHOVMjiuAcZE4HDIwxTL30rymQokQmb7FCglnQsEKd6fwB6Pq_5W6rZZHd3tjh67gb05N0nEedGoKTkONTERV");'></div>
                </a>
            </div>
        </div>
    </header>
    {% endblock %}
    <main class="flex-1">
            {% block body %}{% endblock %}
    </main>
    <footer class="w-full bg-white dark:bg-slate-900 border-t border-[#f0f3f4] dark:border-slate-800">
            <div class="max-w-[1280px] mx-auto px-10 py-8"> <div class="flex flex-wrap justify-center gap-12 text-center md:text-left">

                    <div class="w-full md:w-auto md:max-w-[300px] flex flex-col items-center md:items-start">
                        <div class="flex items-center gap-3 text-primary mb-6">
                            <div class="size-6">
                                <svg fill="none" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M47.2426 24L24 47.2426L0.757355 24L24 0.757355L47.2426 24Z" fill="currentColor"></path>
                                </svg>
                            </div>
                            <h2 class="text-xl font-bold text-[#111518] dark:text-white">TravelTour</h2>
                        </div>
                        <p class="text-[#617989] text-sm">La comunidad más grande del mundo de itinerarios de viaje auténticos y basados en experiencias.</p>
                    </div>

                    <div class="min-w-[150px]">
                        <h4 class="font-bold mb-4">Plataforma</h4>
                        <ul class="space-y-2 text-sm text-[#617989]">
                            <li><a class="hover:text-primary" href="#">Guías</a></li>
                            <li><a class="hover:text-primary" href="#">Creadores</a></li>
                            <li><a class="hover:text-primary" href="#">Comunidad</a></li>
                        </ul>
                    </div>

                    <div class="min-w-[150px]">
                        <h4 class="font-bold mb-4">Soporte</h4>
                        <ul class="space-y-2 text-sm text-[#617989]">
                            <li><a class="hover:text-primary" href="#">Seguridad</a></li>
                            <li><a class="hover:text-primary" href="#">Política de privacidad</a></li>
                            <li><a class="hover:text-primary" href="#">Términos del servicio</a></li>
                        </ul>
                    </div>

                </div>
                <div class="border-t border-[#f0f3f4] dark:border-slate-800 mt-8 pt-6 text-center text-sm text-[#617989]">
                    © 2026 TravelTour. Todos los derechos reservados.
                </div>
            </div>
    </footer>
    </body>
</html>
