{% extends 'base.html.twig' %}

{% block title %}Inicio - TravelTour{% endblock %}

{% block body %}
    <main class="flex-1">
        
        <!-- Hero Section -->
        <section class="relative h-[560px] w-full">
            <div class="absolute inset-0 bg-cover bg-center" style="background-image: linear-gradient(rgba(13, 22, 28, 0.45), rgba(13, 22, 28, 0.65)), url({{ asset('img/home_lago.jpg') }});"></div>
            <div class="relative mx-auto flex h-full max-w-[960px] flex-col items-center justify-center px-6 text-center">
                <h1 class="text-4xl font-black leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
                    Descubre tu próxima aventura auténtica
                </h1>
                <p class="mt-4 text-base font-normal text-slate-100 sm:text-lg mb-8">
                    Forma parte de una comunidad global de viajeros.
                </p>
                <a href="{{ path('app_viaje_index') }}" class="inline-flex h-14 items-center justify-center rounded-xl bg-blue-600 px-8 text-lg font-bold text-white transition-all hover:bg-blue-700 hover:scale-105 shadow-xl">
                    Comienza a explorar
                </a>
            </div>
        </section>

        <!-- Destinations Section (Lugares increíbles) -->
        <section class="max-w-7xl mx-auto px-8 py-24">
            <div class="flex flex-col mb-12">
                <span class="text-blue-600 font-bold tracking-[0.2em] text-xs uppercase mb-2">Explora el mundo</span>
                <h2 class="text-4xl font-extrabold tracking-tight text-slate-900">Descubre lugares increíbles</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Madrid -->
                <div class="group relative aspect-[4/5] rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500">
                    <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" src="{{ asset('img/madrid1.jpg') }}" alt="Madrid"/>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                    <div class="absolute bottom-8 left-8">
                        <h3 class="text-white text-3xl font-bold tracking-tight">Madrid</h3>
                    </div>
                </div>
                <!-- Sintra -->
                <div class="group relative aspect-[4/5] rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 md:mt-12">
                    <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" src="{{ asset('img/sintra.jpg') }}" alt="Sintra"/>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                    <div class="absolute bottom-8 left-8">
                        <h3 class="text-white text-3xl font-bold tracking-tight">Sintra</h3>
                    </div>
                </div>
                <!-- Gante -->
                <div class="group relative aspect-[4/5] rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500">
                    <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" src="{{ asset('img/gante.jpg') }}" alt="Gante"/>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                    <div class="absolute bottom-8 left-8">
                        <h3 class="text-white text-3xl font-bold tracking-tight">Gante</h3>
                    </div>
                </div>
            </div>
        </section>

        <!-- Popular Trips Section (Diseño de Card de Viajes) -->
        <section class="bg-slate-50 dark:bg-slate-950 py-24">
            <div class="max-w-7xl mx-auto px-8">
                <div class="flex justify-between items-end mb-12">
                    <div>
                        <span class="text-blue-600 font-bold tracking-[0.2em] text-xs uppercase mb-2">Favoritos de la comunidad</span>
                        <h2 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">Viajes populares</h2>
                    </div>
                    
                    <a class="flex items-center text-blue-600 font-bold hover:gap-2 transition-all" href="{{ path('app_viaje_index') }}">
                        Ver todos {{ ux_icon('lucide:arrow-right', {'class': 'w-5 h-5 ml-1'}) }}
                    </a>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                    {% for viaje in viajes_populares %}
                        <div class="group flex flex-col overflow-hidden rounded-xl bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-md dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                            <div class="relative aspect-[16/10] overflow-hidden">
                                {# Enlace a la página de show al pinchar en la imagen #}
                                <a href="{{ path('app_viaje_show', {'id': viaje.id}) }}" class="block w-full h-full">
                                    <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" 
                                         alt="{{ viaje.titulo }}" 
                                         src="https://lh3.googleusercontent.com/aida-public/AB6AXuB_fabT81jRizmamsEUioeEM9bgPdIzCRrmoRJjnbu3a-aTHpxvjZ8dUN9nMGrjzAZq_OOlRnd6oTigO7ZUJK09A7wFcZRVnOQMlQd83Y6SIUTyCQQKWMpWrVgXuKYVN0oWTamrcDkY-9bn4kKzmclEx8pQPX1G85W5EIeBR6SppAVyh6UiB43b5CZ2JKE_gs3XLiC8MttQSPDnt5YwXPGN5PISN3M5m9jy4UDazk9fi-J9SUX1tT4kYr7Eg2m_btgfAGxOVThSAtYv"/>
                                </a>
                                
                                {# Etiqueta de duración fija arriba a la izquierda #}
                                <div class="absolute left-3 top-3 rounded-lg bg-teal-600 px-3 py-1 text-xs font-bold text-white shadow-sm truncate max-w-[120px]">
                                    {{ viaje.duracion }} Días
                                </div>
                            </div>
                            
                            <div class="flex flex-1 flex-col p-5">
                                {# Enlace al título #}
                                <a href="{{ path('app_viaje_show', {'id': viaje.id}) }}" class="flex-1">
                                    <h3 class="text-lg font-bold leading-snug text-slate-900 group-hover:text-blue-600 transition-colors dark:text-white line-clamp-2" title="{{ viaje.titulo }}">
                                        {{ viaje.titulo }}
                                    </h3>
                                </a>
                                
                                <div class="mt-4 flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <div class="h-6 w-6 rounded-full bg-slate-200 overflow-hidden flex-shrink-0">
                                            {% if viaje.idUsuario %}
                                                <img class="h-full w-full object-cover" 
                                                     alt="{{ viaje.idUsuario.nickname }}" 
                                                     src="{{ viaje.idUsuario.urlFotoPerfil|default('https://ui-avatars.com/api/?background=random&color=fff&name=' ~ viaje.idUsuario.nickname) }}"/>
                                            {% else %}
                                                <div class="h-full w-full flex items-center justify-center text-xs text-slate-500 bg-slate-200">?</div>
                                            {% endif %}
                                        </div>
                                        <span class="text-xs font-medium text-slate-500 dark:text-slate-400 truncate max-w-[100px]">
                                                {% if viaje.idUsuario %}
                                                     <a href="{{ path('app_usuario_show', {'id': viaje.idUsuario.id}) }}" class="hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white px-1.5 py-0.5 -ml-1.5 rounded transition-all duration-200">
                                                        by @{{ viaje.idUsuario.nickname }}
                                                     </a>
                                                {% else %}
                                                    by @Anónimo
                                                {% endif %}
                                        </span>
                                    </div>
                                    
                                    {# Contador visual de favoritos (Sin botón interactivo) #}
                                    <span class="text-xs font-semibold text-slate-400 flex items-center gap-1">
                                        {{ ux_icon('lucide:heart', {'class': 'w-3 h-3 text-rose-500 ' ~ (viaje.favoritos|length > 0 ? 'fill-rose-500' : '')}) }}
                                        <span>{{ viaje.favoritos|length }}</span> 
                                        <span>{{ viaje.favoritos|length == 1 ? 'guardado' : 'guardados' }}</span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-slate-500 col-span-3 text-center py-12">Todavía no hay viajes destacados.</p>
                    {% endfor %}
                </div>
            </div>
        </section>

    </main>
{% endblock %}