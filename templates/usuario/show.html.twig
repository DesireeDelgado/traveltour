{% extends 'base.html.twig' %}

{% block title %}Perfil de @{{ usuario.nickname }}{% endblock %}

{% block body %}
<main class="mt-[72px] max-w-[1280px] mx-auto px-10">
    <div class="flex flex-col gap-12 py-8">
        <!-- Contenedor del perfil principal -->
        <section class="flex flex-col md:flex-row items-center md:items-start justify-center max-w-4xl mx-auto gap-8 md:gap-12 w-full">
            <!-- Imagen a la izquierda -->
            <div class="w-32 h-32 md:w-48 md:h-48 rounded-full overflow-hidden shadow-2xl border-4 border-white flex-shrink-0">
                <img class="w-full h-full object-cover" 
                     src="{{ usuario.urlFotoPerfil|default('https://ui-avatars.com/api/?background=random&color=fff&name=' ~ usuario.nickname) }}" 
                     alt="{{ usuario.nickname }}">
            </div>
            
            <!-- Detalles de texto -->
            <div class="flex-1 flex flex-col text-center md:text-left pt-2">
                <div class="flex flex-col md:flex-row items-center gap-4 mb-4">
                    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">@{{ usuario.nickname }}</h1>
                    
                    {% if app.user and app.user.id == usuario.id %}
                        <a href="{{ path('app_usuario_edit', {'id': usuario.id}) }}" class="inline-flex items-center justify-center px-4 py-1.5 border border-slate-300 text-slate-600 text-sm font-semibold rounded-full hover:bg-slate-50 transition-all active:scale-95 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800">
                            {{ ux_icon('lucide:pencil', {'class': 'w-3.5 h-3.5 mr-1.5'}) }} Editar Perfil
                        </a>
                    {% endif %}
                </div>
                
                <div class="text-slate-600 dark:text-slate-400 mb-6 max-w-2xl">
                    {% if usuario.biografia %}
                        <p class="leading-relaxed">{{ usuario.biografia }}</p>
                    {% else %}
                        <p class="italic text-slate-400">Sin biografía</p>
                    {% endif %}
                </div>
                
                <!-- Contador de viajes -->
                <div class="flex justify-center md:justify-start gap-8">
                    <div class="text-center md:text-left">
                        <span class="block text-2xl font-extrabold text-slate-900 dark:text-white">{{ usuario.viajes|length }}</span>
                        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mt-1">Viajes</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Sección inferior de viajes -->
        <div class="w-full mt-4">
            <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-8">Mis viajes</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {% for viaje in usuario.viajes %}
                    {# LÓGICA DE PERSISTENCIA #}
                    {% set esFavorito = false %}
                    {% if app.user %}
                        {% for fav in viaje.favoritos %}
                            {% if fav.idUsuario and fav.idUsuario.id == app.user.id %}
                                {% set esFavorito = true %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}

                    <div class="group flex flex-col overflow-hidden rounded-xl bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-md dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                        <div class="relative aspect-[16/10] overflow-hidden">
                            <a href="{{ path('app_viaje_show', {'id': viaje.id}) }}" class="block w-full h-full">
                                {% if viaje.imagenes|length > 0 %}
                                    <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" 
                                         alt="{{ viaje.titulo }}" 
                                         src="{{ path('app_imagen_viaje', {'filename': viaje.imagenes|first.urlPath}) }}"/>
                                {% else %}
                                    <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" 
                                         alt="{{ viaje.titulo }}" 
                                         src="https://lh3.googleusercontent.com/aida-public/AB6AXuB_fabT81jRizmamsEUioeEM9bgPdIzCRrmoRJjnbu3a-aTHpxvjZ8dUN9nMGrjzAZq_OOlRnd6oTigO7ZUJK09A7wFcZRVnOQMlQd83Y6SIUTyCQQKWMpWrVgXuKYVN0oWTamrcDkY-9bn4kKzmclEx8pQPX1G85W5EIeBR6SppAVyh6UiB43b5CZ2JKE_gs3XLiC8MttQSPDnt5YwXPGN5PISN3M5m9jy4UDazk9fi-J9SUX1tT4kYr7Eg2m_btgfAGxOVThSAtYv"/>
                                {% endif %}
                            </a>
                            
                            {# BOTÓN DE FAVORITO DINÁMICO #}
                            <a href="{{ path('app_favoritos_toggle', {'id': viaje.id}) }}" 
                               class="btn-favorito-toggle absolute right-3 top-3 z-10 rounded-full p-2 shadow-sm backdrop-blur transition-all 
                                      {{ esFavorito ? 'bg-rose-500 text-white' : 'bg-white/90 text-rose-500 hover:bg-white dark:bg-slate-800/90' }}">
                                <span class="icon-container">
                                    {{ ux_icon('lucide:heart', {'class': 'w-5 h-5 ' ~ (esFavorito ? 'fill-current' : '')}) }}
                                </span>
                            </a>
                            
                            <div class="absolute left-3 top-3 rounded-lg bg-teal-600 px-3 py-1 text-xs font-bold text-white shadow-sm truncate max-w-[120px]">
                                {{ viaje.duracion }} Días
                            </div>
                        </div>
                        
                        <div class="flex flex-1 flex-col p-5">
                            <a href="{{ path('app_viaje_show', {'id': viaje.id}) }}" class="flex-1">
                                <h3 class="text-lg font-bold leading-snug text-slate-900 group-hover:text-blue-600 transition-colors dark:text-white line-clamp-2" title="{{ viaje.titulo }}">
                                    {{ viaje.titulo }}
                                </h3>
                            </a>
                            
                            <div class="mt-4 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <div class="h-6 w-6 rounded-full bg-slate-200 overflow-hidden flex-shrink-0">
                                        <img class="h-full w-full object-cover" 
                                             alt="{{ usuario.nickname }}" 
                                             src="{{ usuario.urlFotoPerfil|default('https://ui-avatars.com/api/?background=random&color=fff&name=' ~ usuario.nickname) }}"/>
                                    </div>
                                    <span class="text-xs font-medium text-slate-500 dark:text-slate-400 truncate max-w-[100px]">
                                        by @{{ usuario.nickname }}
                                    </span>
                                </div>
                                
                                <span class="text-xs font-semibold text-slate-400 flex items-center gap-1">
                                    <span id="fav-icon-container-{{ viaje.id }}">
                                        {{ ux_icon('lucide:heart', {'class': 'w-3 h-3 text-rose-500 ' ~ (viaje.favoritos|length > 0 ? 'fill-rose-500' : '')}) }}
                                    </span>
                                    <span id="fav-count-{{ viaje.id }}">{{ viaje.favoritos|length }}</span> 
                                    <span id="fav-text-{{ viaje.id }}">{{ viaje.favoritos|length == 1 ? 'guardado' : 'guardados' }}</span>
                                </span>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-span-full py-16 px-6 shadow-sm rounded-xl border border-slate-100 dark:border-slate-800 text-center bg-slate-50 dark:bg-slate-800/50">
                        {{ ux_icon('lucide:map', {'class': 'w-16 h-16 mx-auto mb-4 text-slate-300'}) }}
                        {% if app.user and app.user.id == usuario.id %}
                            <p class="text-lg font-medium text-slate-600 dark:text-slate-300 mb-2">Todavía no has publicado nada</p>
                            <a href="{{ path('app_viaje_new') }}" class="inline-flex bg-blue-600 text-white px-6 py-2.5 rounded-full font-semibold shadow hover:bg-blue-700 transition">
                                Crear nuevo viaje
                            </a>
                        {% else %}
                            <p class="text-lg text-slate-500 font-medium">Este usuario aún no ha publicado ningún viaje.</p>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</main>

<script>
document.addEventListener('click', function(e) {
    const btn = e.target.closest('.btn-favorito-toggle');
    if (!btn) return;

    e.preventDefault();

    const url = btn.getAttribute('href');
    const viajeId = url.split('/').pop();
    const iconContainer = btn.querySelector('.icon-container');
    const countSpan = document.getElementById('fav-count-' + viajeId);
    const textSpan = document.getElementById('fav-text-' + viajeId);
    const footerIconContainer = document.getElementById('fav-icon-container-' + viajeId);

    let currentTotal = parseInt(countSpan.innerText);
    const wasFavorite = btn.classList.contains('bg-rose-500');

    if (wasFavorite) {
        // Desmarcar
        btn.className = 'btn-favorito-toggle absolute right-3 top-3 z-10 rounded-full p-2 shadow-sm backdrop-blur transition-all bg-white/90 text-rose-500 hover:bg-white dark:bg-slate-800/90';
        iconContainer.innerHTML = '<svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>';
        currentTotal--;
    } else {
        // Marcar
        btn.className = 'btn-favorito-toggle absolute right-3 top-3 z-10 rounded-full p-2 shadow-sm backdrop-blur transition-all bg-rose-500 text-white';
        iconContainer.innerHTML = '<svg class="w-5 h-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>';
        currentTotal++;
    }

    countSpan.innerText = currentTotal;
    if (textSpan) textSpan.innerText = currentTotal === 1 ? 'guardado' : 'guardados';
    
    if (footerIconContainer) {
        const footerSvg = footerIconContainer.querySelector('svg');
        currentTotal > 0 ? footerSvg.classList.add('fill-rose-500') : footerSvg.classList.remove('fill-rose-500');
    }

    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
    .then(response => response.json())
    .then(data => {
        const realTotal = data.totalFavoritos ?? data.count;
        if (realTotal !== undefined) {
            countSpan.innerText = realTotal;
            if (textSpan) textSpan.innerText = realTotal === 1 ? 'guardado' : 'guardados';
        }
    })
    .catch(() => window.location.reload());
});

window.onpageshow = function(event) {
    if (event.persisted || (window.performance && window.performance.navigation.type === 2)) {
        window.location.reload();
    }
};
</script>
{% endblock %}
