{% extends 'base.html.twig' %}

{% block title %}Register - TravelTour{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
{% endblock %}

{% block header %}{% endblock %}

{% block body %}
<!-- Utilizamos fixed z-[100] para sobreponernos a la base y ocultar menús globales -->
<div class="fixed inset-0 z-[100] flex flex-col antialiased bg-[#f8f9fa] overflow-y-auto" style="font-family: 'Plus Jakarta Sans', sans-serif;">
    
    

    <!-- Main Content Canvas -->
    <main class="flex-grow flex items-center justify-center pt-12 pb-12 px-4 sm:px-6 lg:px-8">
        <div class="w-full max-w-6xl bg-[#ffffff] rounded-xl sm:rounded-2xl md:rounded-3xl shadow-[0_12px_32px_rgba(25,28,29,0.06)] overflow-hidden flex flex-col md:flex-row border border-[#e7e8e9]">
            
            <!-- Form Section -->
            <div class="w-full md:w-1/2 p-8 sm:p-12 lg:p-16 flex flex-col justify-center bg-[#ffffff]">
                <div class="max-w-md w-full mx-auto">
                    <h2 class="text-3xl sm:text-4xl font-bold text-[#191c1d] tracking-tight mb-2">La aventura te espera</h2>
                    <p class="text-[#404850] text-lg mb-8">Create una cuenta y comienza tu viaje</p>
                    
                    {% set formErrors = form_errors(registrationForm) %}
                    {% if formErrors %}
                        <div class="w-full text-red-600 mb-4 text-center text-sm font-semibold bg-red-100 p-2 rounded-lg">
                            {{ formErrors|raw }}
                        </div>
                    {% endif %}

                    {{ form_start(registrationForm, {'attr': {
                        'class': 'space-y-6', 
                        'novalidate': 'novalidate', 
                        'data-turbo': 'false',
                        'onsubmit': 'setTimeout(() => { this.querySelector("button[type=submit]").disabled = true; this.querySelector("button[type=submit]").innerText = "Creando cuenta, por favor espera..."; }, 0);'
                    }}) }}
                        
                        <!-- Nickname Input -->
                        <div>
                            <label class="block text-sm font-medium text-[#191c1d] mb-2 uppercase tracking-widest" for="nickname">Nickname</label>
                            {{ form_widget(registrationForm.nickname, {
                                'attr': {
                                    'class': 'w-full bg-[#e7e8e9] border-none rounded-full px-5 py-3 focus:bg-[#ffffff] focus:ring-2 focus:ring-[#005d90]/40 focus:outline-none transition-colors text-[#191c1d]',
                                    'placeholder': 'Tu nickname'
                                }
                            }) }}
                            <div class="text-sm text-red-500 mt-1 ml-4">{{ form_errors(registrationForm.nickname) }}</div>
                        </div>

                        <!-- Email Input -->
                        <div>
                            <label class="block text-sm font-medium text-[#191c1d] mb-2 uppercase tracking-widest" for="email">Correo Electrónico</label>
                            {{ form_widget(registrationForm.email, {
                                'attr': {
                                    'class': 'w-full bg-[#e7e8e9] border-none rounded-full px-5 py-3 focus:bg-[#ffffff] focus:ring-2 focus:ring-[#005d90]/40 focus:outline-none transition-colors text-[#191c1d]',
                                    'placeholder': 'alex@traveltour.com'
                                }
                            }) }}
                            <div class="text-sm text-red-500 mt-1 ml-4">{{ form_errors(registrationForm.email) }}</div>
                        </div>
                        
                        <!-- Password Input -->
                        <div>
                            <label class="block text-sm font-medium text-[#191c1d] mb-2 uppercase tracking-widest" for="password">Contraseña</label>
                            {{ form_widget(registrationForm.plainPassword, {
                                'attr': {
                                    'class': 'w-full bg-[#e7e8e9] border-none rounded-full px-5 py-3 focus:bg-[#ffffff] focus:ring-2 focus:ring-[#005d90]/40 focus:outline-none transition-colors text-[#191c1d]',
                                    'placeholder': '••••••••'
                                }
                            }) }}
                            <div class="text-sm text-red-500 mt-1 ml-4">{{ form_errors(registrationForm.plainPassword) }}</div>
                        </div>

                        <!-- Agree Terms -->
                        <div class="flex items-center mt-4">
                            {{ form_widget(registrationForm.agreeTerms, {
                                'attr': {
                                    'class': 'h-5 w-5 rounded border-[#707881] text-[#005d90] focus:ring-[#005d90]/40 bg-[#e7e8e9]'
                                }
                            }) }}
                            <label class="ml-3 block text-sm text-[#404850]" for="terms">
                                Estoy de acuerdo con los <a class="text-[#005d90] hover:text-[#0077b6] font-medium transition-colors" href="#">Términos de Servicio</a> y la <a class="text-[#005d90] hover:text-[#0077b6] font-medium transition-colors" href="#">Política de Privacidad</a>
                            </label>
                        </div>
                        <div class="text-sm text-red-500 mt-1 ml-8">{{ form_errors(registrationForm.agreeTerms) }}</div>

                        <!-- Submit Button -->
                        <div class="pt-4">
                            <button type="submit" class="w-full flex justify-center py-3.5 px-4 border border-transparent rounded-full shadow-[0_12px_32px_rgba(25,28,29,0.06)] text-sm font-medium text-white bg-blue-600 hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#005d90] transition-all duration-200">
                                Crear cuenta
                            </button>
                        </div>
                    {{ form_end(registrationForm) }}

                    <div class="mt-8 text-center flex flex-col gap-2">
                        <p class="text-sm text-[#404850]">
                            ¿Ya tienes una cuenta?
                            <a class="font-medium text-[#005d90] hover:text-[#0077b6] transition-colors" href="{{ path('app_login') }}">Inicia sesión</a>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Image Section -->
            <div class="hidden md:block w-1/2 relative bg-black overflow-hidden pointer-events-none rounded-r-3xl">
                <!-- Imagen trasera (cambio directo) -->
                <img id="slider-image-bg" alt="paisaje fondo" class="absolute inset-0 w-full h-full object-cover object-center" src="{{ asset('img/auroraBoreal.jpg') }}"/>
                <!-- Imagen del frente (transición cruzada) -->
                <img id="slider-image-fg" alt="paisaje frente" class="absolute inset-0 w-full h-full object-cover object-center transition-opacity duration-1000 ease-in-out opacity-100 placeholder-hide z-0" src="{{ asset('img/auroraBoreal.jpg') }}"/>
                
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 to-transparent flex items-end p-12 z-10">
                    <div id="slider-text-container" class="text-white transition-opacity duration-1000 ease-in-out opacity-100">
                        <!-- ID para el título del lugar -->
                        <h3 id="slider-title" class="text-2xl font-bold mb-2 font-headline tracking-wide [text-shadow:-1px_-1px_0_#000,1px_-1px_0_#000,-1px_1px_0_#000,1px_1px_0_#000,0_4px_8px_rgba(0,0,0,0.8)]">Laponia, Finlandia</h3>
                        <!-- ID para la descripción (opcional) -->
                        <p id="slider-desc" class="text-white font-body font-medium tracking-wide [text-shadow:-1px_-1px_0_#000,1px_-1px_0_#000,-1px_1px_0_#000,1px_1px_0_#000,0_2px_4px_rgba(0,0,0,0.8)]">Donde la magia baila en el cielo nocturno.</p>
                    </div>
                </div>
            </div>
        </div>
    </main>
    
    
</div>

<!-- Extraemos este array a JSON para usarlo limpiamente en un archivo js separado -->
<script id="carousel-data" type="application/json">
[
    {
        "img": "{{ asset('img/auroraBoreal.jpg') }}",
        "title": "Laponia, Finlandia",
        "desc": "Donde la magia baila en el cielo nocturno."
    },
    {
        "img": "{{ asset('img/gante.jpg') }}",
        "title": "Gante, Bélgica",
        "desc": "Ciudad vibrante llena de castillos ocultos y canales."
    },
    {
        "img": "{{ asset('img/granada.jpg') }}",
        "title": "Granada, España",
        "desc": "El embrujo del sur bajo las murallas de la Alhambra."
    },
    {
        "img": "{{ asset('img/sintra.jpg') }}",
        "title": "Sintra, Portugal",
        "desc": "Los palacios de cuento que se esconden en la montaña."
    }
]
</script>

<!-- Importamos nuestro script alojado en public/js/ -->
<script src="{{ asset('js/register-carousel.js') }}"></script>

{% endblock %}