{% extends 'base.html.twig' %}

{% block title %}Favoritos index{% endblock %}

{% block body %}
    <h1>Favoritos index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for favorito in favoritos %}
            <tr>
                <td>{{ favorito.id }}</td>
                <td>
                    <a href="{{ path('app_favoritos_show', {'id': favorito.id}) }}">show</a>
                    <a href="{{ path('app_favoritos_edit', {'id': favorito.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="2">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_favoritos_new') }}">Create new</a>
{% endblock %}
